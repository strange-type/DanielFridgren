{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "type": "boolean"
    },
    "author": {
      "type": "string"
    },
    "readingTime": {
      "type": "number"
    },
    "heroImage": {
      "type": "string"
    },
    "heroImageCaption": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "pubDate"
  ]
}