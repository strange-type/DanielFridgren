---
import Spacer from "../Spacer.astro";
---

<section id="subscribe" class="section">
  <div class="grid-columns-2">
    <div></div>
    <div>
      <p class="title-section"></p>
      <div class="prose">
        <h1 class="fadeup-st">Subscribe via RSS</h1>
        <div class="text">
          <Spacer size="xs" />
          <p class="text prose fadeup-st">
            Get new posts as soon as they're published.
          </p>
          <Spacer size="small" />
          <a href="/rss.xml" class="button fadeup-st">Subscribe via RSS</a>
        </div>
      </div>
    </div>
  </div>
</section>
