---
import Layout from "../layouts/Layout.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import Spacer from "../components/Spacer.astro";
import ContactSection from "../components/layouts/ContactSection.astro";
import danielImage from "../assets/images/daniel-fridgren.png";
---

<Layout
    title="About Daniel Fridgren - UX and service design"
    desc="Senior UX and service designer in Malmö, working across healthcare, digital products and complex service systems."
>
    <PageWrapper>
        <Spacer size="xl" />
        <main>
            <div>
                <div class="about-content">
                    <div class="about-image-mobile fadeup-st">
                        <img src={danielImage.src} alt="Daniel Fridgren" />
                    </div>
                    <div class="about-image-desktop fadeup-st">
                        <img src={danielImage.src} alt="Daniel Fridgren" />
                    </div>
                    <div class="about-text-wrapper">
                        <h1 class="title-display fadeup-st about-title-desktop">
                            A bit about me
                        </h1>
                        <div class="text prose fadeup-st">
                            <Spacer size="xs" />
                            <p class="text">
                                I'm a UX and service designer based in Malmö,
                                Sweden. I work with teams that need to make
                                sense of complex services, products and
                                organisations, and turn that understanding into
                                clearer digital experiences.
                            </p>
                            <Spacer size="xs" />
                            <p class="text">
                                My work often sits between strategy and
                                delivery: framing the problem, understanding
                                users and constraints, shaping flows,
                                prototyping and supporting teams as ideas move
                                into implementation.
                            </p>
                            <Spacer size="xs" />
                            <p class="text">
                                Over the last two decades, I've worked across
                                healthcare, product companies and design
                                agencies. My experience spans early work on the
                                first version of Android at Google, digital care
                                journeys, medical devices, B2B SaaS and service
                                design in public healthcare.
                            </p>
                            <Spacer size="xs" />
                            <p class="text">
                                A lot of my thinking is shaped by an interest in
                                psychology, cognition, emergence and complexity:
                                the ways small-scale patterns, constraints and
                                behaviours can give rise to larger systems no
                                one fully controls. That curiosity is also what
                                draws me to design work where the challenge is
                                not just to design an interface, but to
                                understand the system around it.
                            </p>
                            <Spacer size="xs" />
                            <p class="text">
                                Outside of design, I have also made music as a
                                way to <a
                                    href="https://soundcloud.com/poignant-brother/tear-me-not"
                                    target="_blank"
                                    rel="noopener noreferrer">process</a
                                > and <a
                                    href="https://soundcloud.com/fridgren/goodbye"
                                    target="_blank"
                                    rel="noopener noreferrer">explore ideas</a
                                >, and occasionally for demo videos and <a
                                    href="https://soundcloud.com/fridgren/sway-ingame-track-2"
                                    target="_blank"
                                    rel="noopener noreferrer">games</a
                                >.
                            </p>
                            <Spacer size="large" />
                        </div>
                        <h1 class="fadeup-st">Selected experience</h1>
                    </div>
                </div>
            </div>

            <section id="experience" class="section">
                <p class="title-section"></p>
                <div class="prose">
                    <div class="timeline">
                        <div class="timeline-line fadeup-st"></div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    Service Designer <a
                                        href="https://wisecompany.se"
                                    >
                                        • Region Skåne - Digitalisering IT och
                                        MT</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Feb 2026 → Present
                                </div>
                                <div class="timeline-description">
                                    Working across healthcare services and
                                    organisational boundaries to understand
                                    needs, improve digital services and support
                                    change in a complex public healthcare system.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    Design Consultant <a
                                        href="https://wisecompany.se"
                                    >
                                        • In Wise Company</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Jan 2025 → Jan 2026
                                </div>
                                <div class="timeline-description">
                                    Independent consultant helping teams make
                                    sense of products and services through
                                    research, design and prototyping.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div>
                                <div class="heading-sub-lg">
                                    Design Manager <a
                                        href="https://refined.com"
                                    >
                                        • Refined</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Mar 2020 → Oct 2024
                                </div>
                                <div class="timeline-description">
                                    Built and led the design function, helping
                                    teams develop stronger design and discovery
                                    practices and making design a more integral
                                    part of product decisions.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    Senior UX Designer <a
                                        href="https://mindoktor.se"
                                    >
                                        • Min Doktor</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Apr 2016 → Mar 2020
                                </div>
                                <div class="timeline-description">
                                    Designed digital healthcare services for
                                    patients and clinicians, working across
                                    research, service design, UX and product
                                    development in a highly regulated domain.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    Senior UX Designer <a
                                        href="https://topp.se"
                                    >
                                        • TOPP</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Aug 2013 → Apr 2016
                                </div>
                                <div class="timeline-description">
                                    Worked across healthcare, energy, automotive
                                    and connected products, helping teams turn
                                    complicated requirements into usable products
                                    and services.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    UX Designer <a
                                        href="https://www.blackberry.com"
                                    >
                                        • BlackBerry</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Mar 2011 → Jul 2013
                                </div>
                                <div class="timeline-description">
                                    Led design for key parts of BlackBerry 10,
                                    including the home and lock screen
                                    experience, helping define how people
                                    navigated and interacted with the platform.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    Interaction Designer<a href="">
                                        • Color Monkey</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Nov 2009 → Mar 2011
                                </div>
                                <div class="timeline-description">
                                    Worked on interaction design projects
                                    spanning mobile, web and emerging digital
                                    products during a period of rapid change in
                                    the industry.
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item fadeup-st">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="heading-sub-lg">
                                    Interaction Designer<a href="">
                                        • The Astonishing Tribe</a
                                    >
                                </div>
                                <div class="timeline-year">
                                    Jan 2006 → Nov 2009
                                </div>
                                <div class="timeline-description">
                                    Part of the core design team behind the
                                    first version of Android, working on-site
                                    at Google in Mountain View to help shape
                                    early interaction models and user interface
                                    patterns for Android.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <Spacer size="small" />
            <div class="divider"></div>
            <Spacer size="small" />
            <ContactSection />
        </main>
    </PageWrapper>
</Layout>
