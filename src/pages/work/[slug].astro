---
// src/pages/work/[slug].astro
import CaseLayout from "../../layouts/CaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const workItems = await getCollection("work");
  return workItems.map((item) => ({
    params: { slug: item.id },
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error("Missing slug param");

const workItems = await getCollection("work");
const workItem = workItems.find((item) => item.id === slug);

if (!workItem) {
  throw new Response(null, { status: 404 });
}

const { Content } = await render(workItem);
const frontmatter = { ...workItem.data, slug: workItem.id };
---

<CaseLayout {frontmatter}>
  <Content />
</CaseLayout>
