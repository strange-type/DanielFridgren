---
// Punkt is a standalone mini-app, deliberately not using the site's
// shared Layout.astro: it needs its own manifest/start_url/scope so
// "Add to Home Screen" installs *this* app, not fridgren.se.

// Public (non-secret) VAPID key, embedded at build time so the client
// can call pushManager.subscribe() without a round-trip to a function.
const vapidPublicKey = import.meta.env.PUBLIC_PUNKT_VAPID_KEY ?? "";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Punkt</title>
    <script is:inline>
      // Runs before the app script and before first paint: a saved
      // token means we're very likely already logged in, so skip
      // flashing the access-code gate while loadTasks() confirms it —
      // show the (empty) app shell instead. showGate() removes this
      // class again if the token actually turns out to be invalid.
      try {
        if (localStorage.getItem("punkt-token")) {
          document.documentElement.classList.add("punkt-booting");
        }
      } catch {
        // localStorage unavailable (private mode, etc.) — fall through to the gate as normal
      }
    </script>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f8f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#151515" />
    <link rel="manifest" href="/punkt/manifest.webmanifest" />
    <!-- Same artwork as the home-screen/manifest icons below — a
         favicon is just a separate <link>, not a one-per-domain
         thing, so there's no reason the desktop tab can't match. -->
    <link rel="icon" type="image/png" sizes="192x192" href="/punkt/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/punkt/icons/icon-512.png" />
    <link rel="apple-touch-icon" href="/punkt/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Punkt" />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #151515;
        --surface: #232323;
        --border: #383838;
        --text: #f3f4f6;
        --muted: #9a9a9a;
        --accent: #6ea8fe;
        --danger: #f87171;
        --gold: #f5c518;
        --blue-badge: #3b7bf0;
        --red-badge: #ef5b7a;
        --green-badge: #34c759;
        --hairline: rgba(255, 255, 255, 0.06);
        --select-tint: rgba(110, 168, 254, 0.18);
        /* .fab (the add-task button): a circle that reads as barely
           more than the page background itself, given definition by
           a subtle light rim and a soft shadow rather than a filled
           color — see the light-mode override below for the inverse
           (near-white bg, so the shadow does the work instead). */
        --fab-bg: #212121;
        --fab-border: rgba(255, 255, 255, 0.14);
        --fab-shadow:
          0 1px 2px rgba(0, 0, 0, 0.5),
          0 8px 20px rgba(0, 0, 0, 0.55);
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg: #f8f8f6;
          --surface: #f5f5f7;
          --border: #e3e3e7;
          --text: #1c1c1e;
          --muted: #8a8a8e;
          --accent: #2f6fed;
          --danger: #dc2626;
          --hairline: rgba(0, 0, 0, 0.08);
          --select-tint: rgba(47, 111, 237, 0.12);
          --fab-bg: #f1f1ef;
          --fab-border: rgba(255, 255, 255, 0.9);
          --fab-shadow:
            0 1px 2px rgba(0, 0, 0, 0.06),
            0 6px 16px rgba(0, 0, 0, 0.1);
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        /* Kills the elastic rubber-band bounce at the top/bottom of the
           page on iOS — native apps don't wobble when there's nothing
           left to scroll, and neither should this. */
        overscroll-behavior-y: none;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        overflow-x: hidden;
        overscroll-behavior-y: none;
      }

      /* Reserves room for the floating select-bar pill only while it's
         actually shown, so the last row in a long list doesn't end up
         hidden behind it — scoped to #view-list's own padding rather
         than body's so it only grows the page when the list is
         actually close to (or past) one viewport tall. Adding it to
         body unconditionally instead made even a short list — whose
         height is otherwise governed by #app's min-height, not its
         own content — scrollable by that much with nothing there to
         scroll to. */
      body.select-mode #view-list {
        padding-bottom: calc(4rem + env(safe-area-inset-bottom));
      }

      #app {
        position: relative;
        min-height: 100vh;
      }

      #gate {
        max-width: 22rem;
        margin: calc(4rem + env(safe-area-inset-top)) auto 0;
        padding: 0 1rem;
      }

      /* See the head script: while a saved token is being confirmed,
         show the (empty) app shell instead of flashing the gate. */
      html.punkt-booting #gate {
        display: none !important;
      }

      html.punkt-booting #app {
        display: block !important;
      }

      #gate form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .gate-submit {
        background: var(--accent);
        /* --accent is a light blue in dark mode (dark text reads well)
           but a more saturated, darker blue in light mode, where the
           same dark text loses contrast — so it flips to white there. */
        color: #0b1220;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.5rem 0.9rem;
      }

      @media (prefers-color-scheme: light) {
        .gate-submit {
          color: #fff;
        }
      }

      button {
        font: inherit;
        color: inherit;
        background: none;
        border: none;
        cursor: pointer;
      }

      input,
      select,
      textarea {
        font: inherit;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.5rem 0.6rem;
        width: 100%;
      }

      .screen {
        max-width: 32rem;
        margin: 0 auto;
        padding: calc(1.25rem + env(safe-area-inset-top)) 1rem 3rem;
      }

      .screen.sliding {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        transition: transform 0.28s ease;
      }

      /* --- Menu (root) screen -------------------------------------- */

      .menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
      }

      .menu-header h1 {
        font-size: 1.7rem;
        margin: 0;
      }

      .save-error {
        position: fixed;
        bottom: calc(1.25rem + env(safe-area-inset-bottom));
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 30rem);
        background: var(--danger);
        color: #1a0a0a;
        border-radius: 0.7rem;
        padding: 0.6rem 0.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        font-size: 0.85rem;
        z-index: 40;
      }

      .save-error button {
        font-weight: 600;
        text-decoration: underline;
        flex-shrink: 0;
      }

      /* Only shown at all once there's something to report (see
         loadSecuritySummary) — a failed login attempt or an active
         IP block logged server-side. */
      .security-badge {
        position: fixed;
        right: calc(1.25rem + env(safe-area-inset-right));
        bottom: calc(1.25rem + env(safe-area-inset-bottom));
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: var(--danger);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.4);
        z-index: 40;
      }

      .security-badge svg {
        width: 20px;
        height: 20px;
      }

      .security-badge-count {
        position: absolute;
        top: -0.2rem;
        right: -0.2rem;
        min-width: 1.15rem;
        height: 1.15rem;
        padding: 0 0.3rem;
        border-radius: 999px;
        background: #fff;
        color: var(--danger);
        font-size: 0.65rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .security-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 0.2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .security-row:last-child {
        border-bottom: none;
      }

      .security-row-main {
        flex: 1;
        min-width: 0;
      }

      .security-row-ip {
        font-weight: 600;
        font-family: ui-monospace, monospace;
        font-size: 0.95rem;
      }

      .security-row-meta {
        color: #9aa4b8;
        font-size: 0.78rem;
        margin-top: 0.1rem;
      }

      .security-row-status {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
        flex-shrink: 0;
      }

      .security-row-status.blocked {
        background: rgba(248, 113, 113, 0.18);
        color: #f87171;
      }

      .security-row-status.ok {
        background: rgba(154, 164, 184, 0.18);
        color: #9aa4b8;
      }

      .security-unblock {
        flex-shrink: 0;
        background: var(--danger);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.4rem 0.7rem;
        border-radius: 0.5rem;
      }

      #menu-list {
        display: flex;
        flex-direction: column;
      }

      .menu-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 0.6rem;
        border-radius: 0.6rem;
        text-align: left;
        width: 100%;
      }

      .menu-row:active {
        background: var(--surface);
      }

      .menu-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .menu-icon svg {
        width: 16px;
        height: 16px;
        color: white;
      }

      .menu-icon--inbox {
        background: var(--blue-badge);
      }
      .menu-icon--upcoming {
        background: var(--red-badge);
      }
      .menu-icon--logbook {
        background: var(--green-badge);
      }
      .menu-icon--today {
        background: none;
        font-size: 1.5rem;
        color: var(--gold);
      }

      .menu-label {
        flex: 1;
        font-size: 1.05rem;
      }

      .menu-count {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* --- List (detail) screen -------------------------------------- */

      .list-header {
        position: relative;
        z-index: 17;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .list-header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      #back-btn {
        color: var(--muted);
        display: flex;
        padding: 0.25rem;
      }

      #back-btn svg {
        width: 30px;
        height: 30px;
      }

      #list-title {
        font-size: 1.4rem;
        margin: 0;
        cursor: pointer;
      }

      /* Desktop-only (see the @media block below) — doesn't fit
         alongside the back chevron on the mobile screen-swap header. */
      #list-icon {
        display: none;
      }

      .fab {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        background: var(--fab-bg);
        color: var(--text);
        border: 1px solid var(--fab-border);
        box-shadow: var(--fab-shadow);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .fab svg {
        width: 24px;
        height: 24px;
        display: block;
      }

      .fab:active {
        opacity: 0.8;
      }

      .fab[hidden] {
        display: none;
      }

      .list-header-right {
        display: flex;
        align-items: center;
      }

      .done-pill {
        background: var(--accent);
        color: #0b1220;
        font-weight: 600;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
      }

      /* Quick-add: an inline panel that unfolds in place — either at
         the top of the list (adding) or inside the tapped row's own
         slot (editing) — rather than a floating card, so it reads as
         part of the list expanding instead of something popping up
         over it. */
      #quick-add {
        position: relative;
        z-index: 16;
        /* Full-bleed edge-to-edge, so the shadow lines run the full
           width of the screen rather than around a boxed card — width
           and margin-left are computed and set in JS (alignFullBleed)
           rather than here, since a CSS-only 100vw/-50% trick doesn't
           cancel out correctly once #quick-add is nested inside a row
           with asymmetric padding (editing) vs. sitting directly in
           .screen (adding); JS measures the real offset either way. */
        background: var(--bg);
        /* No padding here — with box-sizing: border-box, a max-height
           smaller than the padding sum still renders at that padding
           height (content can't go negative), so a padded box never
           actually reaches 0. The padding lives on .qa-body instead,
           so max-height: 0 there means a truly empty, invisible box —
           no residual sliver popping in/out before/after the smooth
           grow/shrink. margin-top/bottom are 0 at rest for the same
           reason (margin isn't clipped by max-height) and are animated
           in tandem with it in JS.

           overflow: hidden and the animated max-height both live on
           .qa-body, not here — an element clips its OWN box-shadow
           too if it has overflow: hidden, so putting them on the same
           element as the shadow below cut the shadow off flush at the
           left/right edges instead of it softly extending past them
           (invisible on mobile, where the card is edge-to-edge anyway,
           but visible once it's a floating rounded card with room on
           both sides, on the desktop layout). */
        padding: 0;
        margin-top: 0;
        margin-bottom: 0;
        box-shadow:
          0 -6px 14px -6px rgba(0, 0, 0, 0.15),
          0 6px 14px -6px rgba(0, 0, 0, 0.15);
        /* box-shadow and border-radius (the latter only actually set
           on the desktop layout — see its own @media block) are also
           animated, in tandem with the height/margin grow-and-shrink —
           without this, a rounded, shadowed card would instantly pop
           into (or out of) that look the moment it opens (or right as
           it swaps back to a plain row on close), which reads as a
           jump of its own even though the height/position move
           smoothly under it. */
        transition:
          margin-top 0.32s cubic-bezier(0.33, 1, 0.68, 1),
          margin-bottom 0.32s cubic-bezier(0.33, 1, 0.68, 1),
          box-shadow 0.32s ease,
          border-radius 0.32s ease;
      }

      #quick-add .qa-body {
        padding: 0.85rem 1rem;
        overflow: hidden;
        /* opacity's transition is delayed to only run during the
           second half of the close — closing sets it to 0 (see
           playCardCloseAnimation), so the form's own content (title
           input, note, footer) has already faded to invisible by the
           time the shrink finishes and renderTaskList() swaps this
           for the plain row's own (already fully visible) markup.
           Without this, that swap — a real, instant DOM replacement,
           not something a height transition can smooth over — reads
           as a pop of its own even with the height/shadow/radius all
           already animating smoothly. Opening doesn't fade content in
           the same way: the title text already matches (just an
           input now, not styled text), so leaving it visible reads as
           the row expanding to reveal more, not a swap. */
        transition:
          max-height 0.32s cubic-bezier(0.33, 1, 0.68, 1),
          opacity 0.16s ease 0.16s;
      }

      /* Catches taps outside the open panel to close/commit it — kept
         fully transparent since the panel is inline, not a modal, so
         the rest of the list doesn't get dimmed while it's open. */
      #quick-add-scrim {
        position: fixed;
        inset: 0;
        background: transparent;
        z-index: 15;
      }

      #quick-add .qa-title-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding-bottom: 0.6rem;
      }

      #quick-add input:not(.task-check),
      #quick-add textarea {
        background: transparent;
        border: none;
        padding: 0;
        width: 100%;
      }

      #quick-add input:focus,
      #quick-add textarea:focus {
        outline: none;
      }

      #quick-add input::placeholder,
      #quick-add textarea::placeholder {
        color: var(--muted);
      }

      #qa-title {
        font-size: 1.05rem;
      }

      #quick-add #qa-note {
        /* Must stay >= 16px — anything smaller makes iOS Safari
           auto-zoom the whole page in on focus, and in standalone PWA
           mode it sometimes fails to zoom back out cleanly afterwards,
           which shows up as the next screen briefly rendering zoomed
           out before snapping to the correct scale. */
        font-size: 1rem;
        color: var(--muted);
        padding: 0.85rem 1.5rem 0.1rem 1.75rem;
        font-family: inherit;
        resize: none;
        overflow: hidden;
        display: block;
        overflow-wrap: anywhere;
      }

      .qa-footer {
        display: flex;
        align-items: center;
        margin-top: 0.5rem;
        padding-left: 1.75rem;
        gap: 0.5rem;
      }

      .qa-context {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--muted);
        cursor: pointer;
      }

      .qa-context .star {
        color: var(--gold);
      }

      .qa-context svg {
        width: 14px;
        height: 14px;
        display: block;
      }

      .qa-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-left: auto;
      }

      .ghost-icon {
        color: var(--muted);
        padding: 0.2rem;
        border-radius: 0.4rem;
      }

      .ghost-icon.active {
        color: var(--accent);
      }

      .ghost-icon svg {
        width: 17px;
        height: 17px;
        display: block;
      }

      .qa-date {
        width: auto;
        background: transparent;
        border: none;
        color: var(--text);
        font-size: 0.85rem;
        padding: 0;
      }

      /* --- Flat task list, matching Things' plain rows --------------- */

      #task-list {
        list-style: none;
        margin: 0;
        /* Lines up with the back chevron above it, whose glyph has
           empty space baked into the left side of its own icon box —
           measured pixel-for-pixel with Playwright. */
        padding: 0 0 0 15px;
        display: flex;
        flex-direction: column;
      }

      li.task-row {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.55rem 0.5rem;
        margin: 0 -0.5rem;
        border-radius: 0.6rem;
        touch-action: pan-y;
        transition:
          opacity 0.3s ease,
          background 0.2s ease;
      }

      li.task-row.row-fade-out {
        opacity: 0;
      }

      /* The row being edited renders as an empty shell (see
         taskRowHtml) that #quick-add gets moved into — no padding of
         its own so only the panel's padding shows, and no negative
         margin so it doesn't fight the panel's own horizontal spread. */
      li.task-row.editing {
        padding: 0;
        margin: 0;
      }

      li.task-row.row-pending-removal {
        background: var(--surface);
      }

      li.task-row.row-selected {
        background: var(--select-tint);
        /* A small vertical margin so consecutive selected rows show a
           gap between their own rounded corners instead of visually
           merging into one solid block — flex siblings don't collapse
           margins against each other, so this reliably adds up to a
           few px between adjacent selected rows. */
        margin: 2px -0.5rem;
      }

      .select-circle {
        width: 20px;
        height: 20px;
        border: 2px solid var(--muted);
        border-radius: 50%;
        flex-shrink: 0;
        display: grid;
        place-content: center;
      }

      .select-circle.selected {
        background: var(--accent);
        border-color: var(--accent);
      }

      .select-circle.selected::after {
        content: "";
        width: 5px;
        height: 9px;
        border: solid #0b1220;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -1px);
      }

      .select-bar,
      .when-panel {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 30rem);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        z-index: 20;
      }

      .select-bar {
        bottom: calc(1.25rem + env(safe-area-inset-bottom));
        display: flex;
        justify-content: space-around;
        padding: 0.55rem 0.5rem;
      }

      .select-bar[hidden] {
        display: none;
      }

      .select-bar-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        font-size: 0.7rem;
        color: var(--accent);
        padding: 0.2rem 0.75rem;
      }

      .select-bar-btn svg {
        width: 20px;
        height: 20px;
      }

      .select-bar-btn.danger {
        color: var(--danger);
      }

      .when-panel {
        bottom: calc(4.75rem + env(safe-area-inset-bottom));
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
      }

      .when-panel[hidden] {
        display: none;
      }

      .when-panel button {
        color: var(--accent);
        padding: 0.3rem 0.5rem;
      }

      .when-panel input[type="date"] {
        width: auto;
        background: transparent;
        border: none;
        color: var(--text);
        padding: 0;
      }

      .task-check {
        -webkit-appearance: none;
        appearance: none;
        box-sizing: border-box;
        width: 20px;
        height: 20px;
        min-width: 20px;
        min-height: 20px;
        margin: 0;
        padding: 0;
        border: 2px solid var(--muted);
        border-radius: 6px;
        display: grid;
        place-content: center;
        flex-shrink: 0;
      }

      .task-check:checked {
        background: var(--accent);
        border-color: var(--accent);
      }

      .task-check:checked::after {
        content: "";
        width: 5px;
        height: 9px;
        border: solid #0b1220;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -1px);
      }

      .task-title-line {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }

      .task-title-content {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
      }

      .task-title {
        word-break: break-word;
      }

      li.task-row.done .task-title {
        text-decoration: line-through;
        color: var(--muted);
      }

      .task-title-line svg {
        width: 16px;
        height: 16px;
        color: var(--muted);
        flex-shrink: 0;
      }

      .task-note {
        font-size: 0.82rem;
        color: var(--muted);
        margin-left: calc(20px + 0.7rem);
        margin-right: 1rem;
        overflow-wrap: anywhere;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
      }

      .task-note a {
        color: var(--accent);
        text-decoration: underline;
      }

      .date-group {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
        margin: 1.25rem 0 0.4rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--border);
      }

      .task-date-badge {
        color: var(--accent);
        font-weight: 600;
        flex-shrink: 0;
      }

      .date-group.upcoming {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        border-bottom: none;
      }

      .upcoming-day-num {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
      }

      .upcoming-day-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--muted);
        white-space: nowrap;
      }

      .upcoming-day-rule {
        flex: 1;
        align-self: center;
        height: 1px;
        background: var(--border);
      }

      .empty {
        color: var(--muted);
        font-size: 0.9rem;
        padding: 0.5rem 0;
      }

      .error {
        color: var(--danger);
        font-size: 0.85rem;
        min-height: 1.2em;
      }

      /* --- "When?" / "Add Reminder" sheets --------------------------
         Deliberately fixed-dark, not theme-aware: these mimic Things'
         own bottom sheets, which look the same in both app themes. */

      .sheet-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: flex-end;
        z-index: 30;
      }

      .sheet-card {
        width: 100%;
        max-width: 32rem;
        margin: 0 auto;
        background: #1b2333;
        color: #f3f4f6;
        border-radius: 1.1rem 1.1rem 0 0;
        padding: 1rem 1.1rem calc(1.5rem + env(safe-area-inset-bottom));
        max-height: 85vh;
        overflow-y: auto;
      }

      .sheet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .sheet-title {
        font-size: 1.1rem;
        font-weight: 700;
      }

      .sheet-close {
        color: #9aa4b8;
        background: #2c3650;
        border-radius: 50%;
        width: 1.8rem;
        height: 1.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .sheet-close svg {
        width: 14px;
        height: 14px;
      }

      .sheet-row {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 0.2rem;
        text-align: left;
        font-size: 1rem;
        color: #f3f4f6;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .sheet-row-icon {
        width: 1.4rem;
        text-align: center;
        font-size: 1.1rem;
      }

      .sheet-row-icon.star {
        color: #f5c518;
      }

      .sheet-check {
        margin-left: auto;
        width: 16px;
        height: 16px;
        color: #6ea8fe;
      }

      /* #when-reminder-label reuses .sheet-check for its "pushed right"
         positioning, but holds a time string ("11:28") rather than a
         checkmark — it needs room to actually fit that text instead of
         the checkmark's fixed 16px box, which let it overflow past the
         sheet's edge. */
      #when-reminder-label {
        width: auto;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .sheet-check::after {
        content: "";
        display: none;
        width: 5px;
        height: 9px;
        border: solid #6ea8fe;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -3px);
      }

      .sheet-check.checked::after {
        display: block;
      }

      .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        font-size: 0.7rem;
        color: #9aa4b8;
        text-align: center;
        margin-top: 0.75rem;
      }

      .cal-month-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #9aa4b8;
        margin-top: 0.5rem;
      }

      .cal-month-label button {
        color: #6ea8fe;
        padding: 0.2rem 0.5rem;
      }

      .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.2rem;
        margin-top: 0.4rem;
      }

      .cal-day {
        aspect-ratio: 1;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        color: #f3f4f6;
        position: relative;
      }

      .cal-day.selected {
        background: #6ea8fe;
        color: #0b1220;
        font-weight: 600;
      }

      .cal-today-mark {
        position: absolute;
        bottom: 2px;
        font-size: 0.5rem;
        color: #f5c518;
      }

      .sheet-clear {
        width: 100%;
        text-align: center;
        background: #3a2230;
        color: #f87171;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.7rem;
        margin-top: 1rem;
      }

      .reminder-time-input {
        background: #2c3650;
        border: none;
        border-radius: 0.6rem;
        color: #f3f4f6;
        font-size: 1.3rem;
        padding: 0.75rem;
        text-align: center;
        margin: 0.5rem 0 1rem;
      }

      .sheet-actions {
        display: flex;
        gap: 0.6rem;
      }

      .sheet-actions button {
        flex: 1;
        padding: 0.6rem;
        border-radius: 0.6rem;
        text-align: center;
        background: #2c3650;
        color: #f3f4f6;
      }

      .sheet-actions button.primary {
        background: #6ea8fe;
        color: #0b1220;
        font-weight: 600;
      }

      [hidden] {
        display: none !important;
      }

      /* --accent is a light blue in dark mode (dark text/checkmarks
         read well against it) but a more saturated, darker blue in
         light mode, where the same dark elements lose contrast — so
         they flip to white there, same as .gate-submit above. Placed
         after the base rules it overrides (further up this block) so
         the cascade actually picks it up. */
      @media (prefers-color-scheme: light) {
        .done-pill {
          color: #fff;
        }

        .task-check:checked::after,
        .select-circle.selected::after {
          border-color: #fff;
        }
      }

      /* --- Desktop / wide-viewport layout ---------------------------
         A persistent Things-style sidebar sits beside the current
         list instead of the two swapping full-screen like on mobile.
         Reuses the exact same #view-menu/#view-list markup and
         renderMenu()/navigateTo() JS — only the presentation changes;
         navigateTo() still toggles their [hidden] attribute the same
         way it does on mobile (for the "menu" screen-swap case), it
         just no longer has any visible effect here. Keep the
         min-width in sync with the isDesktopLayout() check in the
         script below. */
      @media (min-width: 860px) {
        /* The sidebar and the list each scroll independently within a
           fixed-height #app, rather than the two sitting in normal
           document flow and the whole page scrolling — a sticky
           sidebar (the previous approach) only stays stuck for as
           long as its own height, so once the list scrolled past that
           the sidebar ran out and scrolled away with it instead of
           just always being there. */
        /* No overflow: hidden on #app — #view-menu and #view-list each
           already cap themselves at height: 100%/100vh with their own
           overflow-y: auto, so #app never actually needs this as a
           backstop against growing past one viewport (body stays
           unscrollable either way). It was clipping more than
           intended, though: an ancestor's overflow: hidden clips any
           descendant's box-shadow that bleeds past ITS box too, not
           just its own — including #quick-add's, all the way down
           inside #view-list, cutting it off flush at the left/right
           edges instead of it softly extending past them. */
        #app {
          display: flex;
          align-items: stretch;
          max-width: 74rem;
          height: 100vh;
          margin: 0 auto;
        }

        #view-menu {
          flex: 0 0 15rem;
          width: 15rem;
          max-width: none;
          margin: 0;
          /* Matches #view-list's own padding-top below so the first
             sidebar row and the list's title sit at the same height,
             now that .menu-header (hidden further down) no longer
             pushes the row list down first. */
          padding: calc(2rem + env(safe-area-inset-top)) 0.5rem 2rem 1.5rem;
          background: var(--surface);
          border-right: 1px solid var(--hairline);
          overflow-y: auto;
        }

        /* Always shown as the sidebar, whatever navigateTo() currently
           has its [hidden] attribute set to. */
        #view-menu[hidden] {
          display: flex !important;
          flex-direction: column;
        }

        /* No "Punkt" masthead once the sidebar sits right next to the
           list's own title — see #view-menu's padding-top above. */
        #view-menu .menu-header {
          display: none;
        }

        #view-list {
          flex: 1 1 auto;
          max-width: 40rem;
          margin: 0 auto;
          height: 100%;
          overflow-y: auto;
          padding: calc(2rem + env(safe-area-inset-top)) 2rem 3rem;
        }

        #view-list[hidden] {
          display: block !important;
        }

        /* No "back" concept once the sidebar is always visible. */
        #back-btn {
          display: none !important;
        }

        /* Docked to the window's own corner (not #view-list's, which
           would otherwise leave it stranded far from the true edge
           once the window is wider than the centered content column)
           so it stays put and keeps a generous, constant margin from
           the edge as the window is resized, rather than scrolling
           away with the list underneath it. */
        #add-btn {
          position: fixed;
          top: 2rem;
          right: 3rem;
          z-index: 25;
        }

        /* A neutral gray instead of the accent blue — closer to how
           Things itself highlights the open list — and left as the
           row's own text color rather than forced white, since it's
           no longer a solid saturated fill. */
        .menu-row.active {
          background: var(--border);
        }

        /* #quick-add is deliberately edge-to-edge borderless on
           mobile, but here it already sits inside the bounded content
           column with room on both sides, so rounded corners read as
           part of the page rather than a stray sharp-edged bar. */
        #quick-add {
          border-radius: 0.85rem;
        }

        /* Same icon+label gap as a sidebar row (.menu-row), so the
           icon-to-title spacing here reads as the same design. */
        .list-header-left {
          gap: 0.75rem;
        }

        #list-icon {
          display: flex;
        }

        /* #task-list's mobile padding-left instead lines its rows up
           with the back chevron above it (see its own comment) — that
           chevron is gone here, so this un-does that offset and lines
           rows up with #list-icon's own left edge instead, which sits
           flush with the list header's. */
        #task-list {
          padding-left: 0;
        }

        /* More breathing room between the header and the list below
           it now that there's more vertical space to spend. */
        .list-header {
          margin-bottom: 1.75rem;
        }

        /* .sheet-overlay/.sheet-card (the When?/Add Reminder panels)
           are a mobile bottom sheet — full-width, sliding up from the
           bottom edge, and scrollable if its content runs long. On
           desktop that reads as an oversized mobile control stranded
           in the middle of a much taller window; centering a
           smaller, fixed-width card instead — with the calendar grid
           shrunk to match — comfortably fits Today/This Evening, the
           month calendar, and Add Reminder/Clear without ever needing
           to scroll, closer to how Things' own desktop scheduling
           popover looks. */
        .sheet-overlay {
          align-items: center;
          justify-content: center;
        }

        .sheet-card {
          width: 21rem;
          max-width: 21rem;
          border-radius: 1.1rem;
          max-height: none;
          overflow-y: visible;
          box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.4);
        }

        .sheet-row {
          padding: 0.5rem 0.2rem;
        }

        .cal-grid {
          gap: 0.15rem;
        }

        .cal-day {
          font-size: 0.78rem;
        }
      }
    </style>
  </head>
  <body data-vapid-key={vapidPublicKey}>
    <div id="gate">
      <h1>Punkt</h1>
      <form id="gate-form">
        <input
          id="gate-input"
          type="password"
          placeholder="Åtkomstkod"
          autocomplete="current-password"
          required
        />
        <button type="submit" class="gate-submit">Lås upp</button>
        <p id="gate-error" class="error"></p>
      </form>
    </div>

    <div id="app" hidden>
      <div id="save-error" class="save-error" hidden>
        <span id="save-error-text"></span>
        <button type="button" id="save-error-retry">Försök igen</button>
      </div>

      <button type="button" id="security-badge" class="security-badge" hidden aria-label="Inloggningsförsök">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3Z"></path><path d="M12 8v5M12 16h.01"></path></svg>
        <span id="security-badge-count" class="security-badge-count"></span>
      </button>

      <div id="security-sheet" class="sheet-overlay" hidden>
        <div class="sheet-card">
          <div class="sheet-header">
            <span class="sheet-title">Inloggningsförsök</span>
            <button type="button" id="security-sheet-close" class="sheet-close" aria-label="Stäng">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
            </button>
          </div>
          <div id="security-list"></div>
        </div>
      </div>

      <div id="view-menu" class="screen">
        <div class="menu-header">
          <h1>Punkt</h1>
          <button id="menu-add-btn" class="fab" aria-label="Ny uppgift">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
        </div>
        <nav id="menu-list"></nav>
      </div>

      <div id="view-list" class="screen" hidden>
        <div class="list-header">
          <div class="list-header-left">
            <button id="back-btn" aria-label="Tillbaka">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <!-- Desktop-only (see CSS) — same icon as the matching
                 sidebar row, so the list rows below can align against
                 it instead of against the title text. -->
            <span id="list-icon" class="menu-icon"></span>
            <h1 id="list-title"></h1>
          </div>
          <div class="list-header-right">
            <button id="add-btn" class="fab" aria-label="Ny uppgift">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
            </button>
            <button id="done-btn" class="done-pill" hidden>Done</button>
          </div>
        </div>

        <div id="quick-add-scrim" hidden></div>
        <div id="quick-add-anchor"></div>
        <form id="quick-add" hidden>
          <div class="qa-body">
            <div class="qa-title-row">
              <input type="checkbox" id="qa-checkbox" class="task-check" tabindex="-1" />
              <input id="qa-title" type="text" placeholder="New To-Do" maxlength="200" />
            </div>
            <textarea id="qa-note" placeholder="Notes" rows="1"></textarea>
            <div class="qa-footer">
              <span id="qa-context" class="qa-context" hidden></span>
              <div class="qa-actions">
                <button type="button" id="qa-when-btn" class="ghost-icon" aria-label="Schemalägg">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
                </button>
              </div>
            </div>
          </div>
          <!-- A form with more than one text field only submits on
               Enter if it has an actual submit control — this one
               stays invisible but makes Enter-to-add work from either
               text field. -->
          <button type="submit" hidden>Lägg till</button>
        </form>

        <div id="when-sheet" class="sheet-overlay" hidden>
          <div class="sheet-card">
            <div class="sheet-header">
              <span class="sheet-title">When?</span>
              <button type="button" id="when-sheet-close" class="sheet-close" aria-label="Stäng">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
              </button>
            </div>
            <button type="button" class="sheet-row" data-when-choice="today">
              <span class="sheet-row-icon star">★</span> Today
              <span class="sheet-check" data-check="today"></span>
            </button>
            <button type="button" class="sheet-row" data-when-choice="evening">
              <span class="sheet-row-icon">🌙</span> This Evening
              <span class="sheet-check" data-check="evening"></span>
            </button>
            <div class="cal-month-label">
              <button type="button" id="cal-prev" aria-label="Föregående månad">‹</button>
              <span id="cal-month-name"></span>
              <button type="button" id="cal-next" aria-label="Nästa månad">›</button>
            </div>
            <div class="cal-weekdays">
              <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
            </div>
            <div id="cal-grid" class="cal-grid"></div>
            <button type="button" id="when-add-reminder" class="sheet-row" style="margin-top: 0.75rem; border-bottom: none;">
              <span class="sheet-row-icon">+</span> Add Reminder
              <span id="when-reminder-label" class="sheet-check" style="color:#9aa4b8;"></span>
            </button>
            <button type="button" id="when-clear" class="sheet-clear">Clear</button>
          </div>
        </div>

        <div id="reminder-sheet" class="sheet-overlay" hidden>
          <div class="sheet-card">
            <div class="sheet-header">
              <span class="sheet-title">Add Reminder</span>
            </div>
            <input type="time" id="reminder-time-input" class="reminder-time-input" />
            <div class="sheet-actions">
              <button type="button" id="reminder-cancel">Cancel</button>
              <button type="button" id="reminder-set" class="primary">Set</button>
            </div>
          </div>
        </div>

        <ul id="task-list"></ul>

        <div id="when-panel" class="when-panel" hidden>
          <button type="button" id="wp-today">Idag</button>
          <input type="date" id="wp-date" />
          <button type="button" id="wp-inbox">Inbox</button>
        </div>

        <div id="select-bar" class="select-bar" hidden>
          <button type="button" id="sb-when" class="select-bar-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
            <span>When</span>
          </button>
          <button type="button" id="sb-delete" class="select-bar-btn danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13"></path></svg>
            <span>Delete</span>
          </button>
        </div>
      </div>
    </div>

    <script>
      const TOKEN_KEY = "punkt-token";
      const API = "/.netlify/functions/punkt-tasks";
      const SUBSCRIBE_API = "/.netlify/functions/punkt-subscribe";
      const AUTH_LOG_API = "/.netlify/functions/punkt-auth-log";
      const VAPID_PUBLIC_KEY = document.body.dataset.vapidKey || "";

      type Task = {
        id: string;
        title: string;
        note: string;
        when: string | null; // null | "today" | "YYYY-MM-DD"
        deadline: string | null; // null | "YYYY-MM-DD"
        remind: string | null; // null | "HH:MM"
        notifiedOn: string | null; // null | "YYYY-MM-DD" — set by the server once a reminder has fired
        done: boolean;
        completedAt: string | null;
      };

      type View = "menu" | "inbox" | "today" | "upcoming" | "logbook";

      let tasks: Task[] = [];
      // The GitHub file's sha as of this client's last load or save —
      // sent with every save so the server can tell whether something
      // else (another tab, another device, the scheduled reminders
      // function) changed the file in between, instead of this client
      // blindly overwriting it with its own possibly-stale full copy.
      let tasksSha: string | null = null;
      let currentView: View = "menu";
      let saveInFlight = false;
      let saveQueued = false;
      let selectMode = false;
      let selectedIds = new Set<string>();

      const gate = document.getElementById("gate") as HTMLDivElement;
      const gateForm = document.getElementById("gate-form") as HTMLFormElement;
      const gateInput = document.getElementById("gate-input") as HTMLInputElement;
      const gateError = document.getElementById("gate-error") as HTMLParagraphElement;
      const app = document.getElementById("app") as HTMLElement;
      const saveError = document.getElementById("save-error") as HTMLDivElement;
      const saveErrorText = document.getElementById("save-error-text") as HTMLSpanElement;
      const saveErrorRetry = document.getElementById("save-error-retry") as HTMLButtonElement;
      const securityBadge = document.getElementById("security-badge") as HTMLButtonElement;
      const securityBadgeCount = document.getElementById("security-badge-count") as HTMLSpanElement;
      const securitySheet = document.getElementById("security-sheet") as HTMLDivElement;
      const securitySheetClose = document.getElementById("security-sheet-close") as HTMLButtonElement;
      const securityList = document.getElementById("security-list") as HTMLDivElement;

      const viewMenu = document.getElementById("view-menu") as HTMLDivElement;
      const viewList = document.getElementById("view-list") as HTMLDivElement;
      const menuList = document.getElementById("menu-list") as HTMLElement;
      const menuAddBtn = document.getElementById("menu-add-btn") as HTMLButtonElement;
      const listTitle = document.getElementById("list-title") as HTMLHeadingElement;
      const listIcon = document.getElementById("list-icon") as HTMLSpanElement;
      const backBtn = document.getElementById("back-btn") as HTMLButtonElement;
      const addBtn = document.getElementById("add-btn") as HTMLButtonElement;
      const doneBtn = document.getElementById("done-btn") as HTMLButtonElement;
      const taskListEl = document.getElementById("task-list") as HTMLUListElement;

      const selectBar = document.getElementById("select-bar") as HTMLDivElement;
      const sbWhen = document.getElementById("sb-when") as HTMLButtonElement;
      const sbDelete = document.getElementById("sb-delete") as HTMLButtonElement;
      const whenPanel = document.getElementById("when-panel") as HTMLDivElement;
      const wpToday = document.getElementById("wp-today") as HTMLButtonElement;
      const wpDate = document.getElementById("wp-date") as HTMLInputElement;
      const wpInbox = document.getElementById("wp-inbox") as HTMLButtonElement;

      const quickAdd = document.getElementById("quick-add") as HTMLFormElement;
      // Holds the animated max-height/overflow-clip (see its own CSS
      // comment) — #quick-add itself only handles position/margin/
      // box-shadow now, so its shadow doesn't get clipped along with it.
      const qaBody = quickAdd.querySelector(".qa-body") as HTMLDivElement;
      const quickAddAnchor = document.getElementById("quick-add-anchor") as HTMLDivElement;
      const quickAddScrim = document.getElementById("quick-add-scrim") as HTMLDivElement;
      const qaCheckbox = document.getElementById("qa-checkbox") as HTMLInputElement;
      const qaTitle = document.getElementById("qa-title") as HTMLInputElement;
      const qaNote = document.getElementById("qa-note") as HTMLTextAreaElement;
      const qaContext = document.getElementById("qa-context") as HTMLSpanElement;
      const qaWhenBtn = document.getElementById("qa-when-btn") as HTMLButtonElement;

      const whenSheet = document.getElementById("when-sheet") as HTMLDivElement;
      const whenSheetClose = document.getElementById("when-sheet-close") as HTMLButtonElement;
      const calPrev = document.getElementById("cal-prev") as HTMLButtonElement;
      const calNext = document.getElementById("cal-next") as HTMLButtonElement;
      const calMonthName = document.getElementById("cal-month-name") as HTMLSpanElement;
      const calGrid = document.getElementById("cal-grid") as HTMLDivElement;
      const whenAddReminder = document.getElementById("when-add-reminder") as HTMLButtonElement;
      const whenReminderLabel = document.getElementById("when-reminder-label") as HTMLSpanElement;
      const whenClear = document.getElementById("when-clear") as HTMLButtonElement;

      const reminderSheet = document.getElementById("reminder-sheet") as HTMLDivElement;
      const reminderTimeInput = document.getElementById("reminder-time-input") as HTMLInputElement;
      const reminderCancel = document.getElementById("reminder-cancel") as HTMLButtonElement;
      const reminderSet = document.getElementById("reminder-set") as HTMLButtonElement;

      const ICON_INBOX =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l2-5h14l2 5"/><path d="M3 9v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M3 9h5a1 1 0 0 1 1 1 3 3 0 0 0 6 0 1 1 0 0 1 1-1h5"/></svg>';
      const ICON_UPCOMING =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>';
      const ICON_LOGBOOK =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2 2 4-4"/><rect x="3" y="4" width="18" height="17" rx="2"/></svg>';
      const ICON_NOTE =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h7.2L18 7.3V20.5H7Z"/><path d="M14.2 3.5V7.3H18"/></svg>';
      const ICON_FLAG =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4h11l-2 4 2 4H5"/></svg>';
      const ICON_BELL =
        '<svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a6 6 0 0 0-6 6v3.09c0 .652-.198 1.29-.568 1.827l-1.147 1.673A1.75 1.75 0 0 0 3.68 17.5h12.64a1.75 1.75 0 0 0 1.395-2.9l-1.147-1.673A3.25 3.25 0 0 1 16 11.09V8a6 6 0 0 0-6-6ZM8.05 18a1.95 1.95 0 0 0 3.9 0h-3.9Z" clip-rule="evenodd"/></svg>';

      const VIEW_TITLES: Record<Exclude<View, "menu">, string> = {
        inbox: "Inbox",
        today: "Today",
        upcoming: "Upcoming",
        logbook: "Logbook"
      };

      // Shared with renderMenu()'s sidebar rows and navigateTo()'s
      // desktop list-header icon, so both always show the same glyph.
      const VIEW_ICONS: Record<Exclude<View, "menu">, { iconHtml: string; iconClass: string }> = {
        inbox: { iconHtml: ICON_INBOX, iconClass: "menu-icon--inbox" },
        today: { iconHtml: "★", iconClass: "menu-icon--today" },
        upcoming: { iconHtml: ICON_UPCOMING, iconClass: "menu-icon--upcoming" },
        logbook: { iconHtml: ICON_LOGBOOK, iconClass: "menu-icon--logbook" }
      };

      function todayStr(): string {
        const d = new Date();
        const pad = (n: number) => String(n).padStart(2, "0");
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      }

      function tomorrowStr(): string {
        const d = new Date();
        d.setDate(d.getDate() + 1);
        const pad = (n: number) => String(n).padStart(2, "0");
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      }

      function makeId(): string {
        return `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
      }

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;"
        })[c] as string);
      }

      /** Escapes a note's text, then turns any http(s) URLs in it into
       *  real links — target="_blank" opens a new tab in a browser, or
       *  kicks out to the system browser when running as an installed
       *  home-screen app, since a standalone PWA has no tabs of its
       *  own to open one in. */
      function linkifyNote(text: string): string {
        return escapeHtml(text).replace(/https?:\/\/[^\s<]+/g, (url) => {
          // Trailing punctuation right after a URL is more likely to
          // be sentence punctuation than part of the link itself.
          const trailingMatch = url.match(/[.,;:!?)'"]+$/);
          const trailing = trailingMatch ? trailingMatch[0] : "";
          const href = trailing ? url.slice(0, -trailing.length) : url;
          return `<a href="${href}" target="_blank" rel="noopener noreferrer">${href}</a>${trailing}`;
        });
      }

      async function apiFetch(method: "GET" | "POST", body?: unknown, url: string = API) {
        const token = localStorage.getItem(TOKEN_KEY);
        const res = await fetch(url, {
          method,
          headers: {
            "Content-Type": "application/json",
            "x-punkt-token": token || ""
          },
          body: body ? JSON.stringify(body) : undefined
        });
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          showGate("Fel åtkomstkod.");
          throw new Error("unauthorized");
        }
        if (res.status === 403) {
          // Blocked for too many recent failed attempts — the token
          // itself might still be correct, so it's kept (unlike 401)
          // in case the block lifts before the user tries again.
          showGate("För många felaktiga försök. Försök igen om en stund.");
          throw new Error("blocked");
        }
        if (!res.ok) {
          let detail = "";
          try {
            detail = (await res.json()).error || "";
          } catch {
            // response wasn't JSON — leave detail blank
          }
          throw new Error(`API error ${res.status}${detail ? `: ${detail}` : ""}`);
        }
        return res.json();
      }

      /**
       * Converts the base64url VAPID public key into the Uint8Array
       * shape PushManager.subscribe() expects.
       */
      function urlBase64ToUint8Array(base64: string): Uint8Array {
        const padding = "=".repeat((4 - (base64.length % 4)) % 4);
        const base64Safe = (base64 + padding).replace(/-/g, "+").replace(/_/g, "/");
        const raw = atob(base64Safe);
        return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
      }

      /**
       * Asks for notification permission (if needed) and registers a
       * push subscription with the server. Called the first time the
       * user sets a reminder — a natural moment to ask, since that's
       * exactly when a notification becomes relevant.
       */
      async function ensurePushSubscription() {
        if (!VAPID_PUBLIC_KEY || !("serviceWorker" in navigator) || !("PushManager" in window)) {
          return;
        }
        try {
          const registration = await navigator.serviceWorker.ready;
          let subscription = await registration.pushManager.getSubscription();
          if (!subscription) {
            const permission = await Notification.requestPermission();
            if (permission !== "granted") return;
            subscription = await registration.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
            });
          }
          await apiFetch("POST", { subscription: subscription.toJSON() }, SUBSCRIBE_API);
        } catch (err) {
          console.warn("Punkt: push subscription failed", err);
        }
      }

      function showGate(message = "") {
        // The saved token turned out to be invalid (or there never was
        // one) — lift the head script's optimistic "skip the gate"
        // override so the hidden attributes below actually take effect.
        document.documentElement.classList.remove("punkt-booting");
        app.hidden = true;
        gate.hidden = false;
        gateError.textContent = message;
      }

      function showApp() {
        document.documentElement.classList.remove("punkt-booting");
        gate.hidden = true;
        app.hidden = false;
      }

      function showSaveError(message: string) {
        saveErrorText.textContent = `Kunde inte spara: ${message}`;
        saveError.hidden = false;
      }

      function hideSaveError() {
        saveError.hidden = true;
      }

      saveErrorRetry.addEventListener("click", () => {
        hideSaveError();
        queueSave();
      });

      async function loadTasks() {
        const data = await apiFetch("GET");
        tasks = data.tasks || [];
        tasksSha = data.sha || null;
        renderMenu();
      }

      type AuthLogEntry = {
        ip: string;
        totalAttempts: number;
        recentAttempts: number;
        blocked: boolean;
        lastAttempt: string;
      };

      let securityEntries: AuthLogEntry[] = [];

      /** Best-effort, unlike loadTasks() — a failed fetch here (or the
       *  endpoint just not existing yet on an older deploy) shouldn't
       *  block the app from loading, just leave the badge hidden.
       *  Called once after login, and again whenever the detail sheet
       *  is opened or an IP is unblocked, so it stays current. */
      async function loadSecuritySummary() {
        try {
          const data = await apiFetch("GET", undefined, AUTH_LOG_API);
          securityEntries = data.entries || [];
        } catch (err) {
          console.error("Punkt: failed to load auth log", err);
          return;
        }
        securityBadge.hidden = securityEntries.length === 0;
        securityBadgeCount.textContent = String(securityEntries.length);
        if (!securitySheet.hidden) renderSecurityList();
      }

      function formatAttemptTime(iso: string): string {
        return new Date(iso).toLocaleString("sv-SE", { dateStyle: "short", timeStyle: "short" });
      }

      function renderSecurityList() {
        if (securityEntries.length === 0) {
          securityList.innerHTML = '<p class="empty">Inga inloggningsförsök loggade.</p>';
          return;
        }
        securityList.innerHTML = securityEntries
          .map(
            (e) => `
          <div class="security-row">
            <div class="security-row-main">
              <div class="security-row-ip">${escapeHtml(e.ip)}</div>
              <div class="security-row-meta">${e.recentAttempts} senaste 10 min · ${e.totalAttempts} totalt · senast ${formatAttemptTime(e.lastAttempt)}</div>
            </div>
            ${
              e.blocked
                ? `<button type="button" class="security-unblock" data-unblock-ip="${escapeHtml(e.ip)}">Avblockera</button>`
                : `<span class="security-row-status ok">OK</span>`
            }
          </div>`
          )
          .join("");
      }

      securityBadge.addEventListener("click", () => {
        renderSecurityList();
        securitySheet.hidden = false;
        loadSecuritySummary();
      });

      securitySheetClose.addEventListener("click", () => {
        securitySheet.hidden = true;
      });

      securitySheet.addEventListener("click", (e) => {
        if (e.target === securitySheet) securitySheet.hidden = true;
      });

      securityList.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest("[data-unblock-ip]") as HTMLButtonElement | null;
        if (!btn) return;
        const ip = btn.dataset.unblockIp!;
        btn.disabled = true;
        btn.textContent = "...";
        try {
          await apiFetch("POST", { action: "unblock", ip }, AUTH_LOG_API);
          await loadSecuritySummary();
        } catch (err) {
          console.error("Punkt: failed to unblock IP", err);
          btn.disabled = false;
          btn.textContent = "Avblockera";
        }
      });

      function queueSave() {
        if (saveInFlight) {
          saveQueued = true;
          return;
        }
        saveInFlight = true;
        apiFetch("POST", { tasks, sha: tasksSha })
          .then((data) => {
            hideSaveError();
            tasksSha = data.sha || tasksSha;
            // The server only folds in another writer's tasks (another
            // tab/device, or the scheduled reminders function) when
            // this client's sha was actually stale — re-rendering on
            // every ordinary save would otherwise yank an in-progress
            // edit's #quick-add back out of its row for no reason.
            if (data.merged && Array.isArray(data.tasks)) {
              tasks = data.tasks;
              renderTaskList();
              renderMenu();
            }
          })
          .catch((err) => {
            console.error("Punkt: failed to save tasks", err);
            showSaveError(err.message);
          })
          .finally(() => {
            saveInFlight = false;
            if (saveQueued) {
              saveQueued = false;
              queueSave();
            }
          });
      }

      function bucket(view: View): Task[] {
        const today = todayStr();
        if (view === "inbox") return tasks.filter((t) => !t.done && !t.when);
        if (view === "today")
          return tasks.filter(
            (t) => !t.done && t.when && (t.when === "today" || t.when === "evening" || t.when <= today)
          );
        if (view === "upcoming")
          return tasks
            .filter((t) => !t.done && t.when && t.when !== "today" && t.when !== "evening" && t.when > today)
            .sort((a, b) => (a.when! < b.when! ? -1 : 1));
        if (view === "logbook")
          return tasks
            .filter((t) => t.done)
            .sort((a, b) => (b.completedAt || "").localeCompare(a.completedAt || ""));
        return [];
      }

      // "This Evening" is its own `when` value, independent of whether
      // a reminder is actually set — picking it is just a scheduling
      // choice, not an implicit "and also remind me at 18:00". The
      // `remind === "18:00"` half is a back-compat shim for tasks
      // created before this was its own when value (it used to be
      // when: "today" + an auto-added 18:00 reminder).
      const isEveningTask = (t: Task) => t.when === "evening" || (t.when === "today" && t.remind === "18:00");

      function renderMenu() {
        const views: Exclude<View, "menu">[] = ["inbox", "today", "upcoming", "logbook"];
        menuList.innerHTML = views
          .map((v) => {
            const { iconHtml, iconClass } = VIEW_ICONS[v];
            return `
          <button class="menu-row ${v === currentView ? "active" : ""}" data-nav="${v}">
            <span class="menu-icon ${iconClass}">${iconHtml}</span>
            <span class="menu-label">${VIEW_TITLES[v]}</span>
            <span class="menu-count">${bucket(v).length}</span>
          </button>`;
          })
          .join("");
      }

      function taskRowHtml(task: Task, dateBadge?: string): string {
        // Rendered as an empty shell — openTaskEdit() moves #quick-add
        // into it, so the row expands in place instead of a separate
        // card appearing elsewhere.
        if (task.id === editingTaskId) {
          return `<li class="task-row editing" data-id="${task.id}"></li>`;
        }
        const icons: string[] = [];
        if (task.note) icons.push(ICON_NOTE);
        if (!task.done && task.remind && task.notifiedOn !== todayStr()) icons.push(ICON_BELL);
        if (!task.done && task.deadline) icons.push(ICON_FLAG);
        const selected = selectedIds.has(task.id);
        const indicator = selectMode
          ? `<span class="select-circle ${selected ? "selected" : ""}"></span>`
          : `<input type="checkbox" class="task-check" data-action="toggle" data-id="${task.id}" ${task.done ? "checked" : ""} />`;
        return `
          <li class="task-row ${task.done ? "done" : ""} ${selectMode && selected ? "row-selected" : ""}" data-id="${task.id}">
            <div class="task-title-line">
              ${indicator}
              <span class="task-title-content">
                ${dateBadge ? `<span class="task-date-badge">${dateBadge}</span>` : ""}
                <span class="task-title">${escapeHtml(task.title)}</span>
                ${icons.join("")}
              </span>
            </div>
            ${task.note ? `<div class="task-note">${linkifyNote(task.note)}</div>` : ""}
          </li>`;
      }

      /** "5/9" style compact date, matching Things' Logbook rows. */
      function formatCompactDate(dateStr: string): string {
        const [, month, day] = dateStr.split("-").map(Number);
        return `${day}/${month}`;
      }

      /** Groups Logbook entries the way Things does: Today, Yesterday,
       *  then by month (with the year appended once it's not this year). */
      function logbookGroupLabel(dateStr: string, todayStr: string): string {
        const date = new Date(`${dateStr}T00:00:00`);
        const today = new Date(`${todayStr}T00:00:00`);
        const diffDays = Math.round((today.getTime() - date.getTime()) / 86400000);
        if (diffDays === 0) return "Today";
        if (diffDays === 1) return "Yesterday";
        const sameYear = date.getFullYear() === today.getFullYear();
        const month = date.toLocaleDateString("en-US", { month: "long" });
        return sameYear ? month : `${month} ${date.getFullYear()}`;
      }

      /** Label next to the big day number in Upcoming: "Tomorrow" for
       *  the next day, the weekday name for the rest of this week, else
       *  the month (year appended once it's not this year). */
      function upcomingGroupLabel(dateStr: string, todayStr: string): string {
        const date = new Date(`${dateStr}T00:00:00`);
        const today = new Date(`${todayStr}T00:00:00`);
        const diffDays = Math.round((date.getTime() - today.getTime()) / 86400000);
        if (diffDays === 1) return "Tomorrow";
        if (diffDays > 1 && diffDays < 7) return date.toLocaleDateString("en-US", { weekday: "long" });
        const sameYear = date.getFullYear() === today.getFullYear();
        const month = date.toLocaleDateString("en-US", { month: "short" });
        return sameYear ? month : `${month} ${date.getFullYear()}`;
      }

      function renderTaskList() {
        // #quick-add can currently be nested inside the row being
        // edited — the innerHTML replacement below would destroy it
        // (and everything in it) if it's still in there, so move it
        // back out to its neutral spot first. openTaskEdit() re-parents
        // it into the right row afterward.
        if (taskListEl.contains(quickAdd)) {
          resetQuickAddPosition();
        }

        const items = bucket(currentView as View);

        if (currentView === "upcoming") {
          if (items.length === 0) {
            taskListEl.innerHTML = '<p class="empty">Inget schemalagt.</p>';
            return;
          }
          const today = todayStr();
          let lastDate = "";
          taskListEl.innerHTML = items
            .map((t) => {
              let heading = "";
              if (t.when !== lastDate) {
                const date = new Date(`${t.when}T00:00:00`);
                heading = `
                  <div class="date-group upcoming">
                    <span class="upcoming-day-num">${date.getDate()}</span>
                    <span class="upcoming-day-label">${upcomingGroupLabel(t.when!, today)}</span>
                    <span class="upcoming-day-rule"></span>
                  </div>`;
              }
              lastDate = t.when!;
              return heading + taskRowHtml(t);
            })
            .join("");
          return;
        }

        if (currentView === "today") {
          if (items.length === 0) {
            taskListEl.innerHTML = '<p class="empty">Inget för idag.</p>';
            return;
          }
          const regular = items.filter((t) => !isEveningTask(t));
          const evening = items.filter(isEveningTask);
          let html = regular.map((t) => taskRowHtml(t)).join("");
          if (evening.length > 0) {
            html += `<div class="date-group">🌙 This Evening</div>`;
            html += evening.map((t) => taskRowHtml(t)).join("");
          }
          taskListEl.innerHTML = html;
          return;
        }

        if (currentView === "logbook") {
          if (items.length === 0) {
            taskListEl.innerHTML = '<p class="empty">Inget avklarat än.</p>';
            return;
          }
          const today = todayStr();
          let lastLabel = "";
          taskListEl.innerHTML = items
            .map((t) => {
              const day = (t.completedAt || "").slice(0, 10);
              const label = logbookGroupLabel(day, today);
              const heading = label !== lastLabel ? `<div class="date-group">${label}</div>` : "";
              lastLabel = label;
              return heading + taskRowHtml(t, formatCompactDate(day));
            })
            .join("");
          return;
        }

        taskListEl.innerHTML = items.map((t) => taskRowHtml(t)).join("") || '<p class="empty">Inboxen är tom.</p>';
      }

      function findTask(id: string): Task | undefined {
        return tasks.find((t) => t.id === id);
      }

      let hasShownScreenOnce = false;

      /**
       * Slides `incoming` in over `outgoing`, both full-width — "forward"
       * (menu -> a list) brings the new screen in from the right while
       * the old one exits left; "backward" (a list -> menu) is the
       * mirror image, matching a standard iOS push/pop transition.
       */
      function slideScreens(outgoing: HTMLElement, incoming: HTMLElement, direction: "forward" | "backward") {
        const outTarget = direction === "forward" ? "-100%" : "100%";
        const inStart = direction === "forward" ? "100%" : "-100%";

        outgoing.classList.add("sliding");
        incoming.classList.add("sliding");
        incoming.hidden = false;
        incoming.style.transition = "none";
        incoming.style.transform = `translateX(${inStart})`;
        void incoming.offsetWidth; // force reflow so the transition below actually animates

        outgoing.style.transition = "";
        incoming.style.transition = "";

        requestAnimationFrame(() => {
          outgoing.style.transform = `translateX(${outTarget})`;
          incoming.style.transform = "translateX(0)";
        });

        const onDone = (e: TransitionEvent) => {
          if (e.target !== outgoing) return;
          outgoing.hidden = true;
          outgoing.classList.remove("sliding");
          incoming.classList.remove("sliding");
          outgoing.style.transform = "";
          incoming.style.transform = "";
          outgoing.removeEventListener("transitionend", onDone);
        };
        outgoing.addEventListener("transitionend", onDone);
      }

      // Keep in sync with the "@media (min-width: 860px)" breakpoint in
      // <style> — above it, #view-menu is a persistent sidebar (see
      // that block), so there's no "menu" screen to navigate back to.
      const desktopMediaQuery = window.matchMedia("(min-width: 860px)");
      const isDesktopLayout = () => desktopMediaQuery.matches;

      function navigateTo(view: View) {
        const previousView = currentView;
        currentView = view;
        exitSelectMode();
        const animate = hasShownScreenOnce && previousView !== view;
        hasShownScreenOnce = true;

        if (view === "menu") {
          cancelQuickAdd();
          renderMenu();
          if (animate) {
            slideScreens(viewList, viewMenu, "backward");
          } else {
            viewList.hidden = true;
            viewMenu.hidden = false;
          }
          return;
        }

        listTitle.textContent = VIEW_TITLES[view];
        // Only visible on the desktop sidebar layout (see CSS) — kept
        // in sync unconditionally anyway, same as renderMenu() below.
        const { iconHtml, iconClass } = VIEW_ICONS[view];
        listIcon.className = `menu-icon ${iconClass}`;
        listIcon.innerHTML = iconHtml;
        addBtn.hidden = view === "logbook";
        renderTaskList();
        // Only visibly matters on the desktop sidebar layout, where
        // #menu-list stays on screen while a list is open and needs
        // its active-row highlight to track view switches — on mobile
        // the sidebar markup is just off-screen until the next visit.
        renderMenu();

        if (animate && previousView === "menu") {
          slideScreens(viewMenu, viewList, "forward");
        } else {
          viewMenu.hidden = true;
          viewList.hidden = false;
        }
      }

      menuList.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest("[data-nav]") as HTMLElement | null;
        if (btn) navigateTo(btn.dataset.nav as View);
      });

      backBtn.addEventListener("click", () => navigateTo("menu"));

      // The title itself is a bigger, more obvious tap target for
      // going back than just the small chevron next to it — only
      // active when the chevron itself would be (not mid-select-mode,
      // where it's replaced by the Done button, and not on desktop,
      // where the sidebar replaces the back button entirely and
      // #back-btn is only CSS-hidden, not actually .hidden).
      listTitle.addEventListener("click", () => {
        if (!backBtn.hidden && !isDesktopLayout()) navigateTo("menu");
      });

      // Rows pending removal from the current view (checked off in
      // Today/Inbox/Upcoming, or unchecked in Logbook) — held here so a
      // second toggle before the fade fires can cancel it.
      const pendingRowRemovals = new Map<string, number>();

      taskListEl.addEventListener("change", (e) => {
        const target = e.target as HTMLElement;
        if (target.dataset.action !== "toggle") return;
        const id = target.dataset.id!;
        const task = findTask(id);
        if (!task) return;
        const checked = (target as HTMLInputElement).checked;
        task.done = checked;
        task.completedAt = checked ? new Date().toISOString() : null;
        renderMenu();
        queueSave();

        const existingTimeout = pendingRowRemovals.get(id);
        if (existingTimeout) {
          clearTimeout(existingTimeout);
          pendingRowRemovals.delete(id);
        }

        const row = target.closest(".task-row") as HTMLElement | null;
        if (!row) {
          renderTaskList();
          return;
        }

        // Show the checked/unchecked state immediately...
        row.classList.toggle("done", checked);
        row.classList.remove("row-pending-removal", "row-fade-out");
        row.querySelectorAll<HTMLInputElement>(".task-check").forEach((cb) => (cb.checked = checked));

        const stillBelongsHere = bucket(currentView as View).some((t) => t.id === id);
        if (!stillBelongsHere) {
          // ...highlight it as "about to leave this view"...
          row.classList.add("row-pending-removal");
          // ...then, a beat later, fade it out and only re-render (which
          // actually removes it, since it no longer matches this view)
          // once the fade has finished.
          const timeoutId = window.setTimeout(() => {
            pendingRowRemovals.delete(id);
            row.classList.add("row-fade-out");
            window.setTimeout(() => renderTaskList(), 320);
          }, 1200);
          pendingRowRemovals.set(id, timeoutId);
        }
      });

      // --- Swipe-to-select (Things-style multi-select) --------------------

      function enterSelectMode(id: string) {
        if (selectMode) return;
        selectMode = true;
        selectedIds = new Set([id]);
        closeQuickAdd();
        backBtn.hidden = true;
        addBtn.hidden = true;
        doneBtn.hidden = false;
        selectBar.hidden = false;
        document.body.classList.add("select-mode");
        renderTaskList();
      }

      function exitSelectMode() {
        const wasSelecting = selectMode;
        selectMode = false;
        selectedIds = new Set();
        whenPanel.hidden = true;
        selectBar.hidden = true;
        doneBtn.hidden = true;
        backBtn.hidden = false;
        addBtn.hidden = currentView === "logbook";
        document.body.classList.remove("select-mode");
        if (wasSelecting) renderTaskList();
      }

      doneBtn.addEventListener("click", exitSelectMode);

      let suppressNextClick = false;

      taskListEl.addEventListener("click", (e) => {
        // Let a note's link navigate normally instead of also opening
        // the row for editing (or toggling its selection).
        if ((e.target as HTMLElement).closest("a")) return;
        // The row being edited holds #quick-add itself — without this,
        // clicking into its note (or any other field) would bubble up
        // and re-trigger openTaskEdit below, yanking focus back to the
        // title on every click and making the note unclickable.
        if ((e.target as HTMLElement).closest("#quick-add")) return;
        if (suppressNextClick) {
          suppressNextClick = false;
          return;
        }
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement | null;
        if (!row) return;
        const id = row.dataset.id!;

        if (selectMode) {
          if (selectedIds.has(id)) selectedIds.delete(id);
          else selectedIds.add(id);
          renderTaskList();
          return;
        }

        // The checkbox has its own "change" handler for toggling done —
        // tapping the rest of the row opens the task for editing.
        if ((e.target as HTMLElement).closest(".task-check")) return;
        const task = findTask(id);
        if (task) openTaskEdit(task);
      });

      let swipeActive = false;
      let swipeTriggered = false;
      let swipeStartX = 0;
      let swipeStartY = 0;
      let swipeRowId: string | null = null;

      taskListEl.addEventListener("pointerdown", (e) => {
        if (selectMode) return;
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement | null;
        if (!row) return;
        swipeActive = true;
        swipeTriggered = false;
        swipeStartX = (e as PointerEvent).clientX;
        swipeStartY = (e as PointerEvent).clientY;
        swipeRowId = row.dataset.id || null;
      });

      taskListEl.addEventListener("pointermove", (e) => {
        if (!swipeActive || swipeTriggered || !swipeRowId) return;
        const dx = (e as PointerEvent).clientX - swipeStartX;
        const dy = (e as PointerEvent).clientY - swipeStartY;
        if (Math.abs(dx) > 28 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          swipeTriggered = true;
          suppressNextClick = true;
          enterSelectMode(swipeRowId);
        }
      });

      function endSwipe() {
        swipeActive = false;
        swipeRowId = null;
        if (swipeTriggered) {
          // If the browser follows this drag with a synthetic click, it
          // fires synchronously and consumes the flag itself. If not,
          // clear it shortly after so the *next* real tap isn't swallowed.
          setTimeout(() => {
            suppressNextClick = false;
          }, 0);
        }
      }
      taskListEl.addEventListener("pointerup", endSwipe);
      taskListEl.addEventListener("pointercancel", endSwipe);

      function applyWhenToSelected(when: string | null) {
        for (const id of selectedIds) {
          const t = findTask(id);
          if (t) t.when = when;
        }
        renderMenu();
        queueSave();
        whenPanel.hidden = true;
        exitSelectMode();
      }

      sbWhen.addEventListener("click", () => {
        whenPanel.hidden = !whenPanel.hidden;
      });

      wpToday.addEventListener("click", () => applyWhenToSelected("today"));
      wpInbox.addEventListener("click", () => applyWhenToSelected(null));
      wpDate.addEventListener("change", () => {
        if (wpDate.value) applyWhenToSelected(wpDate.value);
      });

      sbDelete.addEventListener("click", () => {
        if (selectedIds.size === 0) return;
        const count = selectedIds.size;
        if (!confirm(count === 1 ? "Ta bort uppgiften?" : `Ta bort ${count} uppgifter?`)) return;
        tasks = tasks.filter((t) => !selectedIds.has(t.id));
        renderMenu();
        queueSave();
        exitSelectMode();
      });

      // --- Quick add / task edit -------------------------------------

      // The task being composed doesn't exist yet, so its when/remind
      // choice is held here while the "When?"/"Add Reminder" sheets are
      // open, then applied to the new task on commit. The same card and
      // pending vars are reused to edit an existing task — editingTaskId
      // tracks which mode we're in.
      let pendingWhen: string | null = null;
      let pendingRemind: string | null = null;
      let pendingWhenChoice: "today" | "evening" | "date" | null = null;
      let editingTaskId: string | null = null;

      const ICON_BELL_SMALL = ICON_BELL;

      /**
       * Updates the "active" tint on the when-button, and — only once a
       * reminder time is actually set — shows a small context label
       * ("★ Today 🔔13:00") so an edited task's schedule is visible
       * without needing to reopen the When? sheet.
       */
      function updateQaFooter() {
        qaWhenBtn.classList.toggle("active", pendingWhen !== null || pendingRemind !== null);

        if (!pendingRemind) {
          qaContext.hidden = true;
          qaContext.innerHTML = "";
          return;
        }

        let whenLabel = "";
        if (pendingWhenChoice === "today") whenLabel = '<span class="star">★</span> Today';
        else if (pendingWhenChoice === "evening") whenLabel = "🌙 This Evening";
        else if (pendingWhen) whenLabel = escapeHtml(pendingWhen);
        qaContext.innerHTML = `${whenLabel} ${ICON_BELL_SMALL}${pendingRemind}`;
        qaContext.hidden = false;
      }

      /** Moves the (single, shared) quick-add form back to its default
       *  spot above the list — the neutral "not editing anything" home
       *  it returns to once hidden, and where a brand new to-do opens. */
      function resetQuickAddPosition() {
        quickAddAnchor.insertAdjacentElement("afterend", quickAdd);
      }

      /** Moves quick-add into the row it's editing instead, so that
       *  row itself expands to reveal it — taskRowHtml() renders the
       *  row being edited as an empty shell for exactly this to fill. */
      function placeQuickAddInline(taskId: string) {
        const row = taskListEl.querySelector(`.task-row[data-id="${taskId}"]`) as HTMLElement | null;
        if (row) row.appendChild(quickAdd);
      }

      /** Makes #quick-add span #view-list edge-to-edge (not the whole
       *  browser window — on the desktop sidebar layout that would run
       *  it under the sidebar), regardless of how deeply it's
       *  currently nested. A CSS-only 100% + margin-left:50% +
       *  translateX(-50%) trick doesn't cancel out correctly once an
       *  ancestor has asymmetric padding (the row it sits in when
       *  editing has 15px on the left, 0 on the right, to line up with
       *  the back-chevron) — so this measures the real current offset
       *  instead and sets an exact pixel width/margin-left from that,
       *  which works the same whether it's nested in a row (editing)
       *  or sitting directly in .screen (adding). On mobile #view-list
       *  already fills the viewport, so this is equivalent to the old
       *  window.innerWidth-based bleed there.
       *
       *  On desktop, inset by SHADOW_BLEED on each side rather than
       *  filling #view-list exactly: #view-list needs its own
       *  overflow-y: auto for independent scrolling (see #app's CSS),
       *  and per the CSS overflow spec a "y: auto, x: visible" split
       *  on one element isn't possible — the x axis gets forced to
       *  auto too, which clips anything that renders outside
       *  #view-list's own box, including #quick-add's box-shadow, the
       *  same way overflow: hidden would. Sizing the card a little
       *  narrower than #view-list leaves the shadow room to bleed
       *  *within* that already-clipped box instead. */
      function alignQuickAddFullBleed() {
        quickAdd.style.width = "";
        quickAdd.style.marginLeft = "";
        const container = viewList.getBoundingClientRect();
        const left = quickAdd.getBoundingClientRect().left;
        const SHADOW_BLEED = isDesktopLayout() ? 16 : 0;
        quickAdd.style.width = `${container.width - SHADOW_BLEED * 2}px`;
        quickAdd.style.marginLeft = `${container.left - left + SHADOW_BLEED}px`;
      }

      /** Renders task's row markup off-screen — inside the real list,
       *  so it inherits the exact same width/padding/wrapping as a
       *  real row — to measure the height it will occupy once editing
       *  closes. Lets the close animation shrink to that real target
       *  instead of collapsing to 0 and having the closed row pop in
       *  afterward at a different height. A <template> is used to
       *  parse the <li> markup since it isn't restricted to a <ul>'s
       *  normal content model the way directly setting a container's
       *  innerHTML would be. */
      function measureFutureRowHeight(task: Task): number {
        const savedEditingId = editingTaskId;
        editingTaskId = null;
        const template = document.createElement("template");
        template.innerHTML = taskRowHtml(task).trim();
        editingTaskId = savedEditingId;
        const probe = template.content.firstElementChild as HTMLElement | null;
        if (!probe) return 0;
        probe.style.visibility = "hidden";
        taskListEl.appendChild(probe);
        const height = probe.getBoundingClientRect().height;
        probe.remove();
        return height;
      }

      /** Grows or shrinks quick-add between startHeight and its full
       *  content height — an accordion-style reveal in place, whether
       *  it's sitting above the list (adding) or inside the row it
       *  just replaced (editing). Passing the tapped row's own height
       *  as startHeight (instead of always 0) makes the row read as
       *  expanding into the form rather than collapsing away first and
       *  something else growing in afterward. Once the reveal
       *  finishes, max-height is freed to "none" so later content
       *  growth (typing a longer note) isn't clipped by whatever
       *  height happened to be measured at open time. */
      function playCardOpenAnimation(startHeight = 0) {
        alignQuickAddFullBleed();
        quickAdd.style.transition = "none";
        qaBody.style.transition = "none";
        qaBody.style.maxHeight = `${startHeight}px`;
        quickAdd.style.marginTop = "0px";
        quickAdd.style.marginBottom = "0px";
        // Flat, like the plain row it's opening from/into — faded back
        // in below, alongside the height/margin grow.
        quickAdd.style.boxShadow = "none";
        quickAdd.style.borderRadius = "0";
        // In case this is reopening right after a close that got
        // interrupted mid-fade — fully visible immediately, with no
        // delay, rather than picking up the close's fade-in-late timing.
        qaBody.style.opacity = "1";
        void quickAdd.offsetWidth; // force reflow so the transitions below actually animate
        const targetHeight = qaBody.scrollHeight;
        quickAdd.style.transition = "";
        qaBody.style.transition = "";
        requestAnimationFrame(() => {
          qaBody.style.maxHeight = `${targetHeight}px`;
          quickAdd.style.marginTop = "1.5rem";
          quickAdd.style.marginBottom = "1.5rem";
          quickAdd.style.boxShadow = "";
          quickAdd.style.borderRadius = "";
        });
        const onOpenEnd = (e: TransitionEvent) => {
          if (e.target !== qaBody || e.propertyName !== "max-height") return;
          qaBody.removeEventListener("transitionend", onOpenEnd);
          qaBody.style.maxHeight = "none";
        };
        qaBody.addEventListener("transitionend", onOpenEnd);
      }

      /** Mirrors playCardOpenAnimation for dismissal: folds down to
       *  endHeight — 0 to vanish entirely, or the row's future
       *  (post-edit) height so it settles exactly where the plain row
       *  renderTaskList() swaps in afterward will be, avoiding a jump
       *  — then calls onDone (which does that swap). */
      function playCardCloseAnimation(onDone: () => void, endHeight = 0) {
        if (quickAdd.hidden) {
          onDone();
          return;
        }
        // max-height may currently be "none" (freed after opening, so
        // typing could grow it without being clipped) — freeze it at
        // its actual current height first, since transitioning *from*
        // "none" doesn't animate at all.
        qaBody.style.maxHeight = `${qaBody.scrollHeight}px`;
        void quickAdd.offsetWidth;
        const onTransitionEnd = (e: TransitionEvent) => {
          if (e.target !== qaBody || e.propertyName !== "max-height") return;
          qaBody.removeEventListener("transitionend", onTransitionEnd);
          onDone();
        };
        qaBody.addEventListener("transitionend", onTransitionEnd);
        qaBody.style.maxHeight = `${endHeight}px`;
        quickAdd.style.marginTop = "0px";
        quickAdd.style.marginBottom = "0px";
        // Faded out in sync with the collapse so it's already gone by
        // the time renderTaskList() swaps this for the plain row —
        // otherwise the shadow/rounding would just vanish in one
        // frame right at that swap.
        quickAdd.style.boxShadow = "none";
        quickAdd.style.borderRadius = "0";
        // Same reasoning, for the form's own content (title input,
        // note, footer) — see .qa-body's own transition-delay, which
        // keeps this fully visible for the first half of the close and
        // only starts fading for the second, so it's already invisible
        // by the time that swap happens instead of instantly vanishing
        // at that exact moment.
        qaBody.style.opacity = "0";
      }

      function hideQuickAddCard() {
        quickAdd.hidden = true;
        quickAddScrim.hidden = true;
        whenSheet.hidden = true;
        reminderSheet.hidden = true;
        // Always return to the neutral spot once hidden — never leave
        // it parented inside a row that a future renderTaskList() call
        // might destroy along with it.
        resetQuickAddPosition();
      }

      /** Discards any in-progress edit (or new-task draft) and hides
       *  the card immediately, with no animation. Used when navigating
       *  away to a whole different screen: the list is about to be
       *  hidden anyway, and a CSS transition never fires its
       *  transitionend if an ancestor is hidden mid-flight — so the
       *  animated close in closeQuickAdd() would leave the card stuck
       *  invisible but still taking up layout space (an empty gap)
       *  the next time this screen is shown. Also intentionally
       *  doesn't commit pending edits, unlike closing normally —
       *  leaving the screen you were editing on should cancel it. */
      function cancelQuickAdd() {
        editingTaskId = null;
        quickAdd.style.transition = "none";
        qaBody.style.transition = "none";
        hideQuickAddCard();
        qaBody.style.maxHeight = "";
        qaBody.style.opacity = "";
        quickAdd.style.marginTop = "";
        quickAdd.style.marginBottom = "";
        quickAdd.style.boxShadow = "";
        quickAdd.style.borderRadius = "";
        void quickAdd.offsetWidth; // force reflow before restoring the transitions
        quickAdd.style.transition = "";
        qaBody.style.transition = "";
      }

      /** Grows qa-note to fit its (possibly wrapped) content instead of
       *  scrolling — needs re-running after any programmatic .value
       *  change too, since those don't fire the "input" event this is
       *  also bound to. Also keeps quick-add's own max-height in sync
       *  while it's still a fixed px value (mid open/close transition),
       *  so newly-typed content can't get clipped by a stale cap. */
      function autoGrowNote() {
        qaNote.style.height = "auto";
        qaNote.style.height = `${qaNote.scrollHeight}px`;
        if (qaBody.style.maxHeight && qaBody.style.maxHeight !== "none") {
          qaBody.style.maxHeight = `${qaBody.scrollHeight}px`;
        }
      }
      qaNote.addEventListener("input", autoGrowNote);

      function openQuickAdd() {
        editingTaskId = null;
        resetQuickAddPosition();
        quickAdd.hidden = false;
        quickAddScrim.hidden = false;
        playCardOpenAnimation();
        qaCheckbox.checked = false;
        qaTitle.value = "";
        qaNote.value = "";
        autoGrowNote();

        if (currentView === "today") {
          pendingWhen = "today";
          pendingWhenChoice = "today";
        } else if (currentView === "upcoming") {
          // Defaults to tomorrow rather than requiring a date to be
          // picked before the to-do can be added at all — the When
          // sheet is still there (tap the date) for picking a
          // different one.
          pendingWhen = tomorrowStr();
          pendingWhenChoice = "date";
        } else {
          pendingWhen = null;
          pendingWhenChoice = null;
        }
        pendingRemind = null;
        updateQaFooter();

        qaTitle.focus();
      }

      function openTaskEdit(task: Task) {
        // Measured before the row is replaced by the empty editing
        // shell, so the open animation can grow from the tapped row's
        // own height instead of collapsing it to 0 first.
        const tappedRow = taskListEl.querySelector(`.task-row[data-id="${task.id}"]`) as HTMLElement | null;
        const startHeight = tappedRow ? tappedRow.getBoundingClientRect().height : 0;
        editingTaskId = task.id;
        qaCheckbox.checked = task.done;
        qaTitle.value = task.title;
        qaNote.value = task.note;
        pendingWhen = task.when;
        pendingRemind = task.remind;
        pendingWhenChoice = isEveningTask(task)
          ? "evening"
          : task.when === "today"
            ? "today"
            : task.when
              ? "date"
              : null;
        updateQaFooter();
        // Re-render first so this task's row becomes the empty shell
        // quick-add gets moved into — its position in the DOM is only
        // correct once that shell actually exists.
        renderTaskList();
        placeQuickAddInline(task.id);
        quickAdd.hidden = false;
        quickAddScrim.hidden = false;
        // Only once visible — scrollHeight measures 0 on a hidden element.
        autoGrowNote();
        playCardOpenAnimation(startHeight);
        qaTitle.focus();
      }

      function closeQuickAdd() {
        // Idempotent — callers like enterSelectMode() close the card
        // unconditionally as a safety measure, even when it's already
        // closed; without this, that redundant call would re-run
        // addTaskFromQuickAdd() and (before it cleared its own fields)
        // used to resubmit the same just-added title as a duplicate.
        if (quickAdd.hidden) return;
        if (editingTaskId) {
          commitQuickAdd();
          return;
        }
        addTaskFromQuickAdd();
        playCardCloseAnimation(hideQuickAddCard);
      }

      quickAddScrim.addEventListener("click", closeQuickAdd);

      qaCheckbox.addEventListener("change", () => {
        if (!editingTaskId) return;
        const task = findTask(editingTaskId);
        if (!task) return;
        const title = qaTitle.value.trim();
        if (title) task.title = title;
        task.note = qaNote.value.trim();
        // A stale notifiedOn (from an earlier reminder that already
        // fired today) would otherwise silently block a newly-set one
        // from ever firing, since the server only sends reminders where
        // notifiedOn isn't already today.
        if (task.when !== pendingWhen || task.remind !== pendingRemind) task.notifiedOn = null;
        task.when = pendingWhen;
        task.remind = pendingRemind;
        task.done = qaCheckbox.checked;
        task.completedAt = task.done ? new Date().toISOString() : null;
        editingTaskId = null;
        // Only worth morphing into the closed row's own height if it's
        // still going to be in the current view afterward — e.g.
        // checking it done here drops it out of Today/Inbox entirely,
        // so it should just collapse away instead.
        const endHeight = bucket(currentView as View).includes(task) ? measureFutureRowHeight(task) : 0;
        playCardCloseAnimation(() => {
          renderTaskList();
          hideQuickAddCard();
          renderMenu();
          queueSave();
        }, endHeight);
      });

      addBtn.addEventListener("click", () => {
        if (quickAdd.hidden) openQuickAdd();
        else closeQuickAdd();
      });

      // Adding from the root list-picker has no "current view" to add
      // into, so it defaults to Inbox — same as tapping + there.
      menuAddBtn.addEventListener("click", () => {
        navigateTo("inbox");
        openQuickAdd();
      });

      // --- "When?" sheet ---------------------------------------------

      let calendarViewYear = 0;
      let calendarViewMonth = 0; // 0-indexed

      function renderCalendar() {
        const first = new Date(calendarViewYear, calendarViewMonth, 1);
        const startWeekday = (first.getDay() + 6) % 7; // 0 = Monday
        const daysInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate();
        const today = todayStr();
        const pad = (n: number) => String(n).padStart(2, "0");

        // en-US, not sv-SE: this whole sheet deliberately mimics
        // Things' English UI (see the "When?"/"This Evening"/"Mon Tue
        // Wed..." text above) — a Swedish month name here read as an
        // out-of-place mix with everything around it.
        calMonthName.textContent = first.toLocaleDateString("en-US", {
          month: "long",
          year: "numeric"
        });

        const cells: string[] = [];
        for (let i = 0; i < startWeekday; i++) cells.push("<span></span>");
        for (let d = 1; d <= daysInMonth; d++) {
          const dateStr = `${calendarViewYear}-${pad(calendarViewMonth + 1)}-${pad(d)}`;
          const isToday = dateStr === today;
          const isSelected = pendingWhenChoice === "date" && pendingWhen === dateStr;
          cells.push(
            `<button type="button" class="cal-day ${isSelected ? "selected" : ""}" data-date="${dateStr}">${d}${
              isToday ? '<span class="cal-today-mark">★</span>' : ""
            }</button>`
          );
        }
        calGrid.innerHTML = cells.join("");
      }

      function updateWhenSheetChecks() {
        whenSheet.querySelectorAll<HTMLElement>("[data-check]").forEach((el) => {
          el.classList.toggle("checked", el.dataset.check === pendingWhenChoice);
        });
        whenReminderLabel.textContent = pendingRemind || "";
      }

      function openWhenSheet() {
        const now = new Date();
        calendarViewYear = now.getFullYear();
        calendarViewMonth = now.getMonth();
        renderCalendar();
        updateWhenSheetChecks();
        whenSheet.hidden = false;
      }

      qaWhenBtn.addEventListener("click", openWhenSheet);
      qaContext.addEventListener("click", openWhenSheet);
      whenSheetClose.addEventListener("click", () => {
        whenSheet.hidden = true;
        qaTitle.focus();
      });

      whenSheet.addEventListener("click", (e) => {
        if (e.target === whenSheet) {
          whenSheet.hidden = true;
          qaTitle.focus();
          return;
        }

        const choiceBtn = (e.target as HTMLElement).closest("[data-when-choice]") as HTMLElement | null;
        if (choiceBtn) {
          const choice = choiceBtn.dataset.whenChoice;
          if (choice === "today") {
            pendingWhen = "today";
            pendingWhenChoice = "today";
            pendingRemind = null;
          } else if (choice === "evening") {
            // Just a scheduling choice, like "Today" — doesn't imply a
            // reminder on its own. If one's wanted, Add Reminder below
            // defaults its time to 18:00 for this choice specifically.
            pendingWhen = "evening";
            pendingWhenChoice = "evening";
            pendingRemind = null;
          }
          updateQaFooter();
          whenSheet.hidden = true;
          // Otherwise focus is left on this now-hidden button — a
          // dead end for a keyboard/Enter-to-submit user, and (worse,
          // for a *new* to-do) tapping outside the card afterward
          // would discard the whole draft instead of saving it, since
          // closing only commits when editing an existing task.
          qaTitle.focus();
          return;
        }

        const dayBtn = (e.target as HTMLElement).closest(".cal-day") as HTMLElement | null;
        if (dayBtn) {
          pendingWhen = dayBtn.dataset.date || null;
          pendingWhenChoice = "date";
          pendingRemind = null;
          updateQaFooter();
          whenSheet.hidden = true;
          qaTitle.focus();
        }
      });

      calPrev.addEventListener("click", () => {
        calendarViewMonth -= 1;
        if (calendarViewMonth < 0) {
          calendarViewMonth = 11;
          calendarViewYear -= 1;
        }
        renderCalendar();
      });

      calNext.addEventListener("click", () => {
        calendarViewMonth += 1;
        if (calendarViewMonth > 11) {
          calendarViewMonth = 0;
          calendarViewYear += 1;
        }
        renderCalendar();
      });

      whenClear.addEventListener("click", () => {
        pendingWhen = null;
        pendingWhenChoice = null;
        pendingRemind = null;
        updateQaFooter();
        whenSheet.hidden = true;
        qaTitle.focus();
      });

      // --- "Add Reminder" sheet ---------------------------------------

      whenAddReminder.addEventListener("click", () => {
        if (!pendingWhen) {
          pendingWhen = "today";
          pendingWhenChoice = "today";
        }
        const pad = (n: number) => String(n).padStart(2, "0");
        const now = new Date();
        const defaultTime = new Date(now.getTime() + 60 * 60 * 1000);
        const genericDefault = `${pad(defaultTime.getHours())}:${pad(defaultTime.getMinutes())}`;
        // This Evening implies a sensible reminder default of 18:00,
        // rather than the generic "an hour from now" — matching what a
        // reminder for an evening to-do would actually be for. Unless
        // it's already 18:00 or later, in which case 18:00 has already
        // passed and the generic "an hour from now" rule applies same
        // as any other to-do.
        const eveningDefault = now.getHours() >= 18 ? genericDefault : "18:00";
        reminderTimeInput.value =
          pendingRemind || (pendingWhenChoice === "evening" ? eveningDefault : genericDefault);
        whenSheet.hidden = true;
        reminderSheet.hidden = false;
      });

      reminderCancel.addEventListener("click", () => {
        reminderSheet.hidden = true;
        whenSheet.hidden = false;
      });

      reminderSheet.addEventListener("click", (e) => {
        if (e.target === reminderSheet) reminderCancel.click();
      });

      reminderSet.addEventListener("click", () => {
        if (reminderTimeInput.value) {
          pendingRemind = reminderTimeInput.value;
          updateQaFooter();
          void ensurePushSubscription();
        }
        reminderSheet.hidden = true;
        // Setting a reminder is a natural "I'm done configuring this"
        // moment — commit right away instead of waiting for a separate
        // Enter, so the task visibly lands in the list as confirmation
        // the reminder was actually set.
        commitQuickAdd();
      });

      /** Pushes a new task built from the quick-add form's current
       *  fields onto the list and queues a save — shared by
       *  commitQuickAdd() (Enter/submit, which then clears the form
       *  for rapid entry) and closeQuickAdd() (dismissing the card,
       *  which should save whatever was typed rather than discard it).
       *  Returns false if there's no title to save. */
      function addTaskFromQuickAdd(): boolean {
        const title = qaTitle.value.trim();
        if (!title) return false;
        tasks.unshift({
          id: makeId(),
          title,
          note: qaNote.value.trim(),
          when: pendingWhen,
          deadline: null,
          remind: pendingRemind,
          notifiedOn: null,
          done: false,
          completedAt: null
        });
        // Clear right away so a second, unrelated call into this (e.g.
        // closeQuickAdd() firing again via enterSelectMode() after the
        // card is already closed) can't resubmit the same leftover
        // title as a duplicate task.
        qaTitle.value = "";
        qaNote.value = "";
        autoGrowNote();
        renderTaskList();
        renderMenu();
        queueSave();
        return true;
      }

      function commitQuickAdd() {
        if (editingTaskId) {
          const title = qaTitle.value.trim();
          const task = findTask(editingTaskId);
          if (task) {
            if (title) task.title = title;
            task.note = qaNote.value.trim();
            // See the qaCheckbox handler above — a stale notifiedOn
            // would otherwise block a newly-set reminder from firing.
            if (task.when !== pendingWhen || task.remind !== pendingRemind) task.notifiedOn = null;
            task.when = pendingWhen;
            task.remind = pendingRemind;
          }
          editingTaskId = null;
          // See the qaCheckbox handler above — only morph into the
          // closed row's own height if it's still in the current view
          // afterward (e.g. rescheduling it out of Today).
          const endHeight = task && bucket(currentView as View).includes(task) ? measureFutureRowHeight(task) : 0;
          playCardCloseAnimation(() => {
            hideQuickAddCard();
            if (task) {
              renderTaskList();
              renderMenu();
              queueSave();
            }
          }, endHeight);
          return;
        }

        if (!addTaskFromQuickAdd()) return;

        // Things-style rapid entry: keep the card open for the next
        // to-do instead of closing it (addTaskFromQuickAdd() already
        // cleared the fields). The when/reminder choice intentionally
        // carries over to the next to-do.
        qaTitle.focus();
      }

      // A real <form> submit (rather than only listening for a keydown
      // Enter on the title input) is what reliably fires when the
      // return key on iOS's on-screen keyboard is pressed.
      quickAdd.addEventListener("submit", (e) => {
        e.preventDefault();
        commitQuickAdd();
      });

      quickAdd.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeQuickAdd();
      });

      // --- Gate + boot -----------------------------------------------------

      gateForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        localStorage.setItem(TOKEN_KEY, gateInput.value);
        gateError.textContent = "";
        try {
          await loadTasks();
          showApp();
          navigateTo("today");
          void loadSecuritySummary();
        } catch {
          // apiFetch already set a specific message (wrong code,
          // blocked) via showGate() when that's why this failed — only
          // fall back to a generic one if it didn't (network error, etc).
          if (!gate.hidden && !gateError.textContent) {
            gateError.textContent = "Kunde inte ansluta. Försök igen.";
          }
        }
      });

      (async function initServiceWorker() {
        if (!("serviceWorker" in navigator)) return;
        navigator.serviceWorker.register("/punkt/sw.js").catch((err) => {
          console.warn("Punkt: service worker registration failed", err);
        });
      })();

      (async function boot() {
        if (localStorage.getItem(TOKEN_KEY)) {
          try {
            await loadTasks();
            showApp();
            navigateTo("today");
            void loadSecuritySummary();
            return;
          } catch {
            // apiFetch already called showGate() with a specific
            // message (wrong code, blocked) when that's why this
            // failed — re-passing the current text is a no-op for it,
            // but still clears the optimistic "already logged in"
            // state for any other error that didn't set one.
            showGate(gateError.textContent || "");
            return;
          }
        }
        showGate();
      })();
    </script>
  </body>
</html>
