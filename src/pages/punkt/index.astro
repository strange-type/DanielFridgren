---
// Punkt is a standalone mini-app, deliberately not using the site's
// shared Layout.astro: it needs its own manifest/start_url/scope so
// "Add to Home Screen" installs *this* app, not fridgren.se.
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Punkt</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#111827" />
    <link rel="manifest" href="/punkt/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/punkt/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Punkt" />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #111827;
        --surface: #1b2333;
        --border: #2c3650;
        --text: #f3f4f6;
        --muted: #9aa4b8;
        --accent: #6ea8fe;
        --danger: #f87171;
        --gold: #f5c518;
        --blue-badge: #3b7bf0;
        --red-badge: #ef5b7a;
        --green-badge: #34c759;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        padding-bottom: calc(4rem + env(safe-area-inset-bottom));
      }

      #gate {
        max-width: 22rem;
        margin: calc(4rem + env(safe-area-inset-top)) auto 0;
        padding: 0 1rem;
      }

      #gate form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      button {
        font: inherit;
        color: inherit;
        background: none;
        border: none;
        cursor: pointer;
      }

      input,
      select {
        font: inherit;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.5rem 0.6rem;
        width: 100%;
      }

      .screen {
        max-width: 32rem;
        margin: 0 auto;
        padding: calc(1.25rem + env(safe-area-inset-top)) 1rem 3rem;
      }

      /* --- Menu (root) screen -------------------------------------- */

      .menu-header h1 {
        font-size: 1.7rem;
        margin: 0 0 1.25rem;
      }

      #menu-list {
        display: flex;
        flex-direction: column;
      }

      .menu-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 0.25rem;
        border-radius: 0.6rem;
        text-align: left;
        width: 100%;
      }

      .menu-row:active {
        background: var(--surface);
      }

      .menu-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .menu-icon svg {
        width: 16px;
        height: 16px;
        color: white;
      }

      .menu-icon--inbox {
        background: var(--blue-badge);
      }
      .menu-icon--upcoming {
        background: var(--red-badge);
      }
      .menu-icon--logbook {
        background: var(--green-badge);
      }
      .menu-icon--today {
        background: none;
        font-size: 1.5rem;
        color: var(--gold);
      }

      .menu-label {
        flex: 1;
        font-size: 1.05rem;
      }

      .menu-count {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* --- List (detail) screen -------------------------------------- */

      .list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .list-header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      #back-btn {
        color: var(--accent);
        display: flex;
        padding: 0.25rem;
      }

      #back-btn svg {
        width: 22px;
        height: 22px;
      }

      #list-title {
        font-size: 1.4rem;
        margin: 0;
      }

      .fab {
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        background: var(--accent);
        color: #0b1220;
        font-size: 1.4rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .fab:active {
        opacity: 0.8;
      }

      .fab[hidden] {
        display: none;
      }

      .list-header-right {
        display: flex;
        align-items: center;
      }

      .done-pill {
        background: var(--accent);
        color: #0b1220;
        font-weight: 600;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
      }

      /* Quick-add card: fields have no visible box of their own — just
         a faintly elevated card so they read as "almost invisible". */
      #quick-add {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.9rem;
        padding: 0.85rem 1rem;
        margin-bottom: 1.25rem;
      }

      #quick-add .qa-title-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .checkbox-decor {
        width: 20px;
        height: 20px;
        border: 2px solid var(--muted);
        border-radius: 6px;
        flex-shrink: 0;
      }

      #quick-add input {
        background: transparent;
        border: none;
        padding: 0;
        width: 100%;
      }

      #quick-add input:focus {
        outline: none;
      }

      #quick-add input::placeholder {
        color: var(--muted);
      }

      #qa-title {
        font-size: 1.05rem;
      }

      #qa-note {
        font-size: 0.9rem;
        color: var(--muted);
        padding: 0.5rem 0 0.1rem 1.75rem;
      }

      .qa-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.5rem;
        padding-left: 1.75rem;
        gap: 0.5rem;
      }

      .qa-context {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .qa-context .star {
        color: var(--gold);
      }

      .qa-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .ghost-icon {
        color: var(--muted);
        padding: 0.2rem;
        border-radius: 0.4rem;
      }

      .ghost-icon.active {
        color: var(--accent);
      }

      .ghost-icon svg {
        width: 17px;
        height: 17px;
        display: block;
      }

      .qa-date {
        width: auto;
        background: transparent;
        border: none;
        color: var(--text);
        font-size: 0.85rem;
        padding: 0;
      }

      /* --- Flat task list, matching Things' plain rows --------------- */

      #task-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      li.task-row {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        padding: 0.55rem 0.5rem;
        margin: 0 -0.5rem;
        border-radius: 0.6rem;
        touch-action: pan-y;
      }

      li.task-row.row-selected {
        background: rgba(110, 168, 254, 0.18);
      }

      .select-circle {
        width: 20px;
        height: 20px;
        margin-top: 0.1rem;
        border: 2px solid var(--muted);
        border-radius: 50%;
        flex-shrink: 0;
        display: grid;
        place-content: center;
      }

      .select-circle.selected {
        background: var(--accent);
        border-color: var(--accent);
      }

      .select-circle.selected::after {
        content: "";
        width: 5px;
        height: 9px;
        border: solid #0b1220;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -1px);
      }

      .select-bar,
      .when-panel {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 30rem);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        z-index: 20;
      }

      .select-bar {
        bottom: calc(1.25rem + env(safe-area-inset-bottom));
        display: flex;
        justify-content: space-around;
        padding: 0.55rem 0.5rem;
      }

      .select-bar[hidden] {
        display: none;
      }

      .select-bar-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        font-size: 0.7rem;
        color: var(--accent);
        padding: 0.2rem 0.75rem;
      }

      .select-bar-btn svg {
        width: 20px;
        height: 20px;
      }

      .select-bar-btn.danger {
        color: var(--danger);
      }

      .when-panel {
        bottom: calc(4.75rem + env(safe-area-inset-bottom));
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
      }

      .when-panel[hidden] {
        display: none;
      }

      .when-panel button {
        color: var(--accent);
        padding: 0.3rem 0.5rem;
      }

      .when-panel input[type="date"] {
        width: auto;
        background: transparent;
        border: none;
        color: var(--text);
        padding: 0;
      }

      .task-check {
        appearance: none;
        width: 20px;
        height: 20px;
        margin-top: 0.1rem;
        border: 2px solid var(--muted);
        border-radius: 6px;
        display: grid;
        place-content: center;
        flex-shrink: 0;
      }

      .task-check:checked {
        background: var(--accent);
        border-color: var(--accent);
      }

      .task-check:checked::after {
        content: "";
        width: 5px;
        height: 9px;
        border: solid #0b1220;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -1px);
      }

      .task-body {
        flex: 1;
        min-width: 0;
      }

      .task-title-line {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
      }

      .task-title {
        word-break: break-word;
      }

      li.task-row.done .task-title {
        text-decoration: line-through;
        color: var(--muted);
      }

      .task-title-line svg {
        width: 14px;
        height: 14px;
        color: var(--muted);
        flex-shrink: 0;
      }

      .task-note {
        font-size: 0.82rem;
        color: var(--muted);
        margin-top: 0.1rem;
      }

      .date-group {
        font-size: 0.75rem;
        color: var(--muted);
        margin: 0.9rem 0 0.1rem;
      }

      .empty {
        color: var(--muted);
        font-size: 0.9rem;
        padding: 0.5rem 0;
      }

      .error {
        color: var(--danger);
        font-size: 0.85rem;
        min-height: 1.2em;
      }

      [hidden] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <div id="gate">
      <h1>Punkt</h1>
      <form id="gate-form">
        <input
          id="gate-input"
          type="password"
          placeholder="Åtkomstkod"
          autocomplete="current-password"
          required
        />
        <button
          type="submit"
          style="background:var(--accent);color:#0b1220;font-weight:600;border-radius:0.5rem;padding:0.5rem 0.9rem;"
          >Lås upp</button
        >
        <p id="gate-error" class="error"></p>
      </form>
    </div>

    <div id="app" hidden>
      <div id="view-menu" class="screen">
        <div class="menu-header">
          <h1>Punkt</h1>
        </div>
        <nav id="menu-list"></nav>
      </div>

      <div id="view-list" class="screen" hidden>
        <div class="list-header">
          <div class="list-header-left">
            <button id="back-btn" aria-label="Tillbaka">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h1 id="list-title"></h1>
          </div>
          <div class="list-header-right">
            <button id="add-btn" class="fab" aria-label="Ny uppgift">+</button>
            <button id="done-btn" class="done-pill" hidden>Done</button>
          </div>
        </div>

        <div id="quick-add" hidden>
          <div class="qa-title-row">
            <span class="checkbox-decor"></span>
            <input id="qa-title" type="text" placeholder="New To-Do" maxlength="200" />
          </div>
          <input id="qa-note" type="text" placeholder="Notes" />
          <div class="qa-footer">
            <span id="qa-context" class="qa-context"></span>
            <div class="qa-actions">
              <button type="button" id="qa-when-toggle" class="ghost-icon" aria-label="Schemalägg" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
              </button>
              <input type="date" id="qa-when" class="qa-date" hidden />
              <button type="button" id="qa-deadline-toggle" class="ghost-icon" aria-label="Deadline">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4h11l-2 4 2 4H5"></path></svg>
              </button>
              <input type="date" id="qa-deadline" class="qa-date" hidden />
            </div>
          </div>
        </div>

        <ul id="task-list"></ul>

        <div id="when-panel" class="when-panel" hidden>
          <button type="button" id="wp-today">Idag</button>
          <input type="date" id="wp-date" />
          <button type="button" id="wp-inbox">Inbox</button>
        </div>

        <div id="select-bar" class="select-bar" hidden>
          <button type="button" id="sb-when" class="select-bar-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
            <span>When</span>
          </button>
          <button type="button" id="sb-delete" class="select-bar-btn danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13"></path></svg>
            <span>Delete</span>
          </button>
        </div>
      </div>
    </div>

    <script>
      const TOKEN_KEY = "punkt-token";
      const API = "/.netlify/functions/punkt-tasks";

      type Task = {
        id: string;
        title: string;
        note: string;
        when: string | null; // null | "today" | "YYYY-MM-DD"
        deadline: string | null; // null | "YYYY-MM-DD"
        done: boolean;
        completedAt: string | null;
      };

      type View = "menu" | "inbox" | "today" | "upcoming" | "logbook";

      let tasks: Task[] = [];
      let currentView: View = "menu";
      let saveInFlight = false;
      let saveQueued = false;
      let selectMode = false;
      let selectedIds = new Set<string>();

      const gate = document.getElementById("gate") as HTMLDivElement;
      const gateForm = document.getElementById("gate-form") as HTMLFormElement;
      const gateInput = document.getElementById("gate-input") as HTMLInputElement;
      const gateError = document.getElementById("gate-error") as HTMLParagraphElement;
      const app = document.getElementById("app") as HTMLElement;

      const viewMenu = document.getElementById("view-menu") as HTMLDivElement;
      const viewList = document.getElementById("view-list") as HTMLDivElement;
      const menuList = document.getElementById("menu-list") as HTMLElement;
      const listTitle = document.getElementById("list-title") as HTMLHeadingElement;
      const backBtn = document.getElementById("back-btn") as HTMLButtonElement;
      const addBtn = document.getElementById("add-btn") as HTMLButtonElement;
      const doneBtn = document.getElementById("done-btn") as HTMLButtonElement;
      const taskListEl = document.getElementById("task-list") as HTMLUListElement;

      const selectBar = document.getElementById("select-bar") as HTMLDivElement;
      const sbWhen = document.getElementById("sb-when") as HTMLButtonElement;
      const sbDelete = document.getElementById("sb-delete") as HTMLButtonElement;
      const whenPanel = document.getElementById("when-panel") as HTMLDivElement;
      const wpToday = document.getElementById("wp-today") as HTMLButtonElement;
      const wpDate = document.getElementById("wp-date") as HTMLInputElement;
      const wpInbox = document.getElementById("wp-inbox") as HTMLButtonElement;

      const quickAdd = document.getElementById("quick-add") as HTMLDivElement;
      const qaTitle = document.getElementById("qa-title") as HTMLInputElement;
      const qaNote = document.getElementById("qa-note") as HTMLInputElement;
      const qaContext = document.getElementById("qa-context") as HTMLSpanElement;
      const qaWhenToggle = document.getElementById("qa-when-toggle") as HTMLButtonElement;
      const qaWhen = document.getElementById("qa-when") as HTMLInputElement;
      const qaDeadlineToggle = document.getElementById("qa-deadline-toggle") as HTMLButtonElement;
      const qaDeadline = document.getElementById("qa-deadline") as HTMLInputElement;

      const ICON_INBOX =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l2-5h14l2 5"/><path d="M3 9v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M3 9h5a1 1 0 0 1 1 1 3 3 0 0 0 6 0 1 1 0 0 1 1-1h5"/></svg>';
      const ICON_UPCOMING =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>';
      const ICON_LOGBOOK =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2 2 4-4"/><rect x="3" y="4" width="18" height="17" rx="2"/></svg>';
      const ICON_NOTE =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/></svg>';
      const ICON_FLAG =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4h11l-2 4 2 4H5"/></svg>';

      const VIEW_TITLES: Record<Exclude<View, "menu">, string> = {
        inbox: "Inbox",
        today: "Today",
        upcoming: "Upcoming",
        logbook: "Logbook"
      };

      function todayStr(): string {
        const d = new Date();
        const pad = (n: number) => String(n).padStart(2, "0");
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      }

      function makeId(): string {
        return `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
      }

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;"
        })[c] as string);
      }

      async function apiFetch(method: "GET" | "POST", body?: unknown) {
        const token = localStorage.getItem(TOKEN_KEY);
        const res = await fetch(API, {
          method,
          headers: {
            "Content-Type": "application/json",
            "x-punkt-token": token || ""
          },
          body: body ? JSON.stringify(body) : undefined
        });
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          showGate("Fel åtkomstkod.");
          throw new Error("unauthorized");
        }
        if (!res.ok) {
          throw new Error(`API error ${res.status}`);
        }
        return res.json();
      }

      function showGate(message = "") {
        app.hidden = true;
        gate.hidden = false;
        gateError.textContent = message;
      }

      function showApp() {
        gate.hidden = true;
        app.hidden = false;
      }

      async function loadTasks() {
        const data = await apiFetch("GET");
        tasks = data.tasks || [];
        renderMenu();
      }

      function queueSave() {
        if (saveInFlight) {
          saveQueued = true;
          return;
        }
        saveInFlight = true;
        apiFetch("POST", { tasks })
          .catch((err) => console.error("Punkt: failed to save tasks", err))
          .finally(() => {
            saveInFlight = false;
            if (saveQueued) {
              saveQueued = false;
              queueSave();
            }
          });
      }

      function bucket(view: View): Task[] {
        const today = todayStr();
        if (view === "inbox") return tasks.filter((t) => !t.done && !t.when);
        if (view === "today")
          return tasks.filter((t) => !t.done && t.when && (t.when === "today" || t.when <= today));
        if (view === "upcoming")
          return tasks
            .filter((t) => !t.done && t.when && t.when !== "today" && t.when > today)
            .sort((a, b) => (a.when! < b.when! ? -1 : 1));
        if (view === "logbook")
          return tasks
            .filter((t) => t.done)
            .sort((a, b) => (b.completedAt || "").localeCompare(a.completedAt || ""));
        return [];
      }

      function renderMenu() {
        const rows: { view: Exclude<View, "menu">; label: string; iconHtml: string; iconClass: string }[] = [
          { view: "inbox", label: "Inbox", iconHtml: ICON_INBOX, iconClass: "menu-icon--inbox" },
          { view: "today", label: "Today", iconHtml: "★", iconClass: "menu-icon--today" },
          { view: "upcoming", label: "Upcoming", iconHtml: ICON_UPCOMING, iconClass: "menu-icon--upcoming" },
          { view: "logbook", label: "Logbook", iconHtml: ICON_LOGBOOK, iconClass: "menu-icon--logbook" }
        ];
        menuList.innerHTML = rows
          .map(
            (r) => `
          <button class="menu-row" data-nav="${r.view}">
            <span class="menu-icon ${r.iconClass}">${r.iconHtml}</span>
            <span class="menu-label">${r.label}</span>
            <span class="menu-count">${bucket(r.view).length}</span>
          </button>`
          )
          .join("");
      }

      function taskRowHtml(task: Task): string {
        const icons: string[] = [];
        if (task.note) icons.push(ICON_NOTE);
        if (!task.done && task.deadline) icons.push(ICON_FLAG);
        const selected = selectedIds.has(task.id);
        const indicator = selectMode
          ? `<span class="select-circle ${selected ? "selected" : ""}"></span>`
          : `<input type="checkbox" class="task-check" data-action="toggle" data-id="${task.id}" ${task.done ? "checked" : ""} />`;
        return `
          <li class="task-row ${task.done ? "done" : ""} ${selectMode && selected ? "row-selected" : ""}" data-id="${task.id}">
            ${indicator}
            <div class="task-body">
              <div class="task-title-line">
                <span class="task-title">${escapeHtml(task.title)}</span>
                ${icons.join("")}
              </div>
              ${task.note ? `<div class="task-note">${escapeHtml(task.note)}</div>` : ""}
            </div>
          </li>`;
      }

      function renderTaskList() {
        const items = bucket(currentView as View);

        if (currentView === "upcoming") {
          if (items.length === 0) {
            taskListEl.innerHTML = '<p class="empty">Inget schemalagt.</p>';
            return;
          }
          let lastDate = "";
          taskListEl.innerHTML = items
            .map((t) => {
              const heading = t.when !== lastDate ? `<div class="date-group">${t.when}</div>` : "";
              lastDate = t.when!;
              return heading + taskRowHtml(t);
            })
            .join("");
          return;
        }

        if (currentView === "logbook") {
          if (items.length === 0) {
            taskListEl.innerHTML = '<p class="empty">Inget avklarat än.</p>';
            return;
          }
          let lastDay = "";
          taskListEl.innerHTML = items
            .map((t) => {
              const day = (t.completedAt || "").slice(0, 10);
              const heading = day !== lastDay ? `<div class="date-group">${day}</div>` : "";
              lastDay = day;
              return heading + taskRowHtml(t);
            })
            .join("");
          return;
        }

        const emptyLabel = currentView === "inbox" ? "Inboxen är tom." : "Inget för idag.";
        taskListEl.innerHTML = items.map((t) => taskRowHtml(t)).join("") || `<p class="empty">${emptyLabel}</p>`;
      }

      function findTask(id: string): Task | undefined {
        return tasks.find((t) => t.id === id);
      }

      function navigateTo(view: View) {
        currentView = view;
        exitSelectMode();
        if (view === "menu") {
          closeQuickAdd();
          viewList.hidden = true;
          viewMenu.hidden = false;
          renderMenu();
          return;
        }
        viewMenu.hidden = true;
        viewList.hidden = false;
        listTitle.textContent = VIEW_TITLES[view];
        addBtn.hidden = view === "logbook";
        renderTaskList();
      }

      menuList.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest("[data-nav]") as HTMLElement | null;
        if (btn) navigateTo(btn.dataset.nav as View);
      });

      backBtn.addEventListener("click", () => navigateTo("menu"));

      taskListEl.addEventListener("change", (e) => {
        const target = e.target as HTMLElement;
        if (target.dataset.action !== "toggle") return;
        const id = target.dataset.id!;
        const task = findTask(id);
        if (!task) return;
        const checked = (target as HTMLInputElement).checked;
        task.done = checked;
        task.completedAt = checked ? new Date().toISOString() : null;
        renderTaskList();
        renderMenu();
        queueSave();
      });

      // --- Swipe-to-select (Things-style multi-select) --------------------

      function enterSelectMode(id: string) {
        if (selectMode) return;
        selectMode = true;
        selectedIds = new Set([id]);
        closeQuickAdd();
        backBtn.hidden = true;
        addBtn.hidden = true;
        doneBtn.hidden = false;
        selectBar.hidden = false;
        renderTaskList();
      }

      function exitSelectMode() {
        const wasSelecting = selectMode;
        selectMode = false;
        selectedIds = new Set();
        whenPanel.hidden = true;
        selectBar.hidden = true;
        doneBtn.hidden = true;
        backBtn.hidden = false;
        addBtn.hidden = currentView === "logbook";
        if (wasSelecting) renderTaskList();
      }

      doneBtn.addEventListener("click", exitSelectMode);

      let suppressNextClick = false;

      taskListEl.addEventListener("click", (e) => {
        if (suppressNextClick) {
          suppressNextClick = false;
          return;
        }
        if (!selectMode) return;
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement | null;
        if (!row) return;
        const id = row.dataset.id!;
        if (selectedIds.has(id)) selectedIds.delete(id);
        else selectedIds.add(id);
        renderTaskList();
      });

      let swipeActive = false;
      let swipeTriggered = false;
      let swipeStartX = 0;
      let swipeStartY = 0;
      let swipeRowId: string | null = null;

      taskListEl.addEventListener("pointerdown", (e) => {
        if (selectMode) return;
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement | null;
        if (!row) return;
        swipeActive = true;
        swipeTriggered = false;
        swipeStartX = (e as PointerEvent).clientX;
        swipeStartY = (e as PointerEvent).clientY;
        swipeRowId = row.dataset.id || null;
      });

      taskListEl.addEventListener("pointermove", (e) => {
        if (!swipeActive || swipeTriggered || !swipeRowId) return;
        const dx = (e as PointerEvent).clientX - swipeStartX;
        const dy = (e as PointerEvent).clientY - swipeStartY;
        if (Math.abs(dx) > 28 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          swipeTriggered = true;
          suppressNextClick = true;
          enterSelectMode(swipeRowId);
        }
      });

      function endSwipe() {
        swipeActive = false;
        swipeRowId = null;
        if (swipeTriggered) {
          // If the browser follows this drag with a synthetic click, it
          // fires synchronously and consumes the flag itself. If not,
          // clear it shortly after so the *next* real tap isn't swallowed.
          setTimeout(() => {
            suppressNextClick = false;
          }, 0);
        }
      }
      taskListEl.addEventListener("pointerup", endSwipe);
      taskListEl.addEventListener("pointercancel", endSwipe);

      function applyWhenToSelected(when: string | null) {
        for (const id of selectedIds) {
          const t = findTask(id);
          if (t) t.when = when;
        }
        renderMenu();
        queueSave();
        whenPanel.hidden = true;
        exitSelectMode();
      }

      sbWhen.addEventListener("click", () => {
        whenPanel.hidden = !whenPanel.hidden;
      });

      wpToday.addEventListener("click", () => applyWhenToSelected("today"));
      wpInbox.addEventListener("click", () => applyWhenToSelected(null));
      wpDate.addEventListener("change", () => {
        if (wpDate.value) applyWhenToSelected(wpDate.value);
      });

      sbDelete.addEventListener("click", () => {
        if (selectedIds.size === 0) return;
        const count = selectedIds.size;
        if (!confirm(count === 1 ? "Ta bort uppgiften?" : `Ta bort ${count} uppgifter?`)) return;
        tasks = tasks.filter((t) => !selectedIds.has(t.id));
        renderMenu();
        queueSave();
        exitSelectMode();
      });

      // --- Quick add -----------------------------------------------------

      function openQuickAdd() {
        quickAdd.hidden = false;
        qaTitle.value = "";
        qaNote.value = "";
        qaWhen.value = "";
        qaDeadline.value = "";
        qaWhen.hidden = true;
        qaDeadline.hidden = true;
        qaWhenToggle.classList.remove("active");
        qaDeadlineToggle.classList.remove("active");

        if (currentView === "today") {
          qaContext.innerHTML = '<span class="star">★</span> Today';
          qaWhenToggle.hidden = true;
        } else if (currentView === "upcoming") {
          qaContext.textContent = "Upcoming";
          qaWhenToggle.hidden = true;
          qaWhen.hidden = false;
        } else {
          qaContext.textContent = "Inbox";
          qaWhenToggle.hidden = false;
        }

        qaTitle.focus();
      }

      function closeQuickAdd() {
        quickAdd.hidden = true;
      }

      addBtn.addEventListener("click", () => {
        if (quickAdd.hidden) openQuickAdd();
        else closeQuickAdd();
      });

      qaWhenToggle.addEventListener("click", () => {
        qaWhen.hidden = !qaWhen.hidden;
        qaWhenToggle.classList.toggle("active", !qaWhen.hidden);
        if (!qaWhen.hidden) qaWhen.focus();
      });

      qaDeadlineToggle.addEventListener("click", () => {
        qaDeadline.hidden = !qaDeadline.hidden;
        qaDeadlineToggle.classList.toggle("active", !qaDeadline.hidden);
        if (!qaDeadline.hidden) qaDeadline.focus();
      });

      function commitQuickAdd() {
        const title = qaTitle.value.trim();
        if (!title) return;

        let when: string | null = null;
        if (currentView === "today") when = "today";
        else if (currentView === "upcoming") {
          if (!qaWhen.value) {
            qaWhen.hidden = false;
            qaWhen.focus();
            return;
          }
          when = qaWhen.value;
        } else if (!qaWhen.hidden && qaWhen.value) {
          when = qaWhen.value;
        }

        tasks.push({
          id: makeId(),
          title,
          note: qaNote.value.trim(),
          when,
          deadline: qaDeadline.value || null,
          done: false,
          completedAt: null
        });

        renderTaskList();
        renderMenu();
        queueSave();

        // Things-style rapid entry: clear and keep the card open for
        // the next to-do instead of closing it.
        qaTitle.value = "";
        qaNote.value = "";
        qaTitle.focus();
      }

      qaTitle.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          commitQuickAdd();
        } else if (e.key === "Escape") {
          closeQuickAdd();
        }
      });

      qaNote.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeQuickAdd();
      });

      // --- Gate + boot -----------------------------------------------------

      gateForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        localStorage.setItem(TOKEN_KEY, gateInput.value);
        gateError.textContent = "";
        try {
          await loadTasks();
          showApp();
          navigateTo("menu");
        } catch {
          if (!gate.hidden) gateError.textContent = "Kunde inte ansluta. Försök igen.";
        }
      });

      (async function initServiceWorker() {
        if (!("serviceWorker" in navigator)) return;
        navigator.serviceWorker.register("/punkt/sw.js").catch((err) => {
          console.warn("Punkt: service worker registration failed", err);
        });
      })();

      (async function boot() {
        if (localStorage.getItem(TOKEN_KEY)) {
          try {
            await loadTasks();
            showApp();
            navigateTo("menu");
            return;
          } catch {
            // fall through to gate
          }
        }
        showGate();
      })();
    </script>
  </body>
</html>
