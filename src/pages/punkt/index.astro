        <div id="select-bar" class="select-bar" hidden>
          <button type="button" id="sb-when" class="select-bar-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
            <span>When</span>
          </button>
          <button type="button" id="sb-delete" class="select-bar-btn danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13"></path></svg>
            <span>Delete</span>
          </button>
        </div>
      </div>
    </div>

    <script>
      const TOKEN_KEY = "punkt-token";
      const API = "/.netlify/functions/punkt-tasks";
      const SUBSCRIBE_API = "/.netlify/functions/punkt-subscribe";
      const VAPID_PUBLIC_KEY = document.body.dataset.vapidKey || "";

      type Task = {
        id: string;
        title: string;
        note: string;
        when: string | null; // null | "today" | "YYYY-MM-DD"
        deadline: string | null; // null | "YYYY-MM-DD"
        remind: string | null; // null | "HH:MM"
        notifiedOn: string | null; // null | "YYYY-MM-DD" — set by the server once a reminder has fired
        done: boolean;
        completedAt: string | null;
      };

      type View = "menu" | "inbox" | "today" | "upcoming" | "logbook";

      let tasks: Task[] = [];
      let currentView: View = "menu";
      let saveInFlight = false;
      let saveQueued = false;
      let selectMode = false;
      let selectedIds = new Set<string>();

      const gate = document.getElementById("gate") as HTMLDivElement;
      const gateForm = document.getElementById("gate-form") as HTMLFormElement;
      const gateInput = document.getElementById("gate-input") as HTMLInputElement;
      const gateError = document.getElementById("gate-error") as HTMLParagraphElement;
      const app = document.getElementById("app") as HTMLElement;
      const saveError = document.getElementById("save-error") as HTMLDivElement;
      const saveErrorText = document.getElementById("save-error-text") as HTMLSpanElement;
      const saveErrorRetry = document.getElementById("save-error-retry") as HTMLButtonElement;

      const viewMenu = document.getElementById("view-menu") as HTMLDivElement;
      const viewList = document.getElementById("view-list") as HTMLDivElement;
      const menuList = document.getElementById("menu-list") as HTMLElement;
      const menuAddBtn = document.getElementById("menu-add-btn") as HTMLButtonElement;
      const listTitle = document.getElementById("list-title") as HTMLHeadingElement;
      const backBtn = document.getElementById("back-btn") as HTMLButtonElement;
      const addBtn = document.getElementById("add-btn") as HTMLButtonElement;
      const doneBtn = document.getElementById("done-btn") as HTMLButtonElement;
      const taskListEl = document.getElementById("task-list") as HTMLUListElement;

      const selectBar = document.getElementById("select-bar") as HTMLDivElement;
      const sbWhen = document.getElementById("sb-when") as HTMLButtonElement;
      const sbDelete = document.getElementById("sb-delete") as HTMLButtonElement;
      const whenPanel = document.getElementById("when-panel") as HTMLDivElement;
      const wpToday = document.getElementById("wp-today") as HTMLButtonElement;
      const wpDate = document.getElementById("wp-date") as HTMLInputElement;
      const wpInbox = document.getElementById("wp-inbox") as HTMLButtonElement;

      const quickAdd = document.getElementById("quick-add") as HTMLFormElement;
      const quickAddAnchor = document.getElementById("quick-add-anchor") as HTMLDivElement;
      const quickAddScrim = document.getElementById("quick-add-scrim") as HTMLDivElement;
      const qaCheckbox = document.getElementById("qa-checkbox") as HTMLInputElement;
      const qaTitle = document.getElementById("qa-title") as HTMLInputElement;
      const qaNote = document.getElementById("qa-note") as HTMLInputElement;
      const qaContext = document.getElementById("qa-context") as HTMLSpanElement;
      const qaWhenBtn = document.getElementById("qa-when-btn") as HTMLButtonElement;

      const whenSheet = document.getElementById("when-sheet") as HTMLDivElement;
      const whenSheetClose = document.getElementById("when-sheet-close") as HTMLButtonElement;
      const calPrev = document.getElementById("cal-prev") as HTMLButtonElement;
      const calNext = document.getElementById("cal-next") as HTMLButtonElement;
      const calMonthName = document.getElementById("cal-month-name") as HTMLSpanElement;
      const calGrid = document.getElementById("cal-grid") as HTMLDivElement;
      const whenAddReminder = document.getElementById("when-add-reminder") as HTMLButtonElement;
      const whenReminderLabel = document.getElementById("when-reminder-label") as HTMLSpanElement;
      const whenClear = document.getElementById("when-clear") as HTMLButtonElement;

      const reminderSheet = document.getElementById("reminder-sheet") as HTMLDivElement;
      const reminderTimeInput = document.getElementById("reminder-time-input") as HTMLInputElement;
      const reminderCancel = document.getElementById("reminder-cancel") as HTMLButtonElement;
      const reminderSet = document.getElementById("reminder-set") as HTMLButtonElement;

      const ICON_INBOX =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l2-5h14l2 5"/><path d="M3 9v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M3 9h5a1 1 0 0 1 1 1 3 3 0 0 0 6 0 1 1 0 0 1 1-1h5"/></svg>';
      const ICON_UPCOMING =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>';
      const ICON_LOGBOOK =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2 2 4-4"/><rect x="3" y="4" width="18" height="17" rx="2"/></svg>';
      const ICON_NOTE =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h7.2L18 7.3V20.5H7Z"/><path d="M14.2 3.5V7.3H18"/></svg>';
      const ICON_FLAG =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4h11l-2 4 2 4H5"/></svg>';
      const ICON_BELL =
        '<svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a6 6 0 0 0-6 6v3.09c0 .652-.198 1.29-.568 1.827l-1.147 1.673A1.75 1.75 0 0 0 3.68 17.5h12.64a1.75 1.75 0 0 0 1.395-2.9l-1.147-1.673A3.25 3.25 0 0 1 16 11.09V8a6 6 0 0 0-6-6ZM8.05 18a1.95 1.95 0 0 0 3.9 0h-3.9Z" clip-rule="evenodd"/></svg>';

      const VIEW_TITLES: Record<Exclude<View, "menu">, string> = {
        inbox: "Inbox",
        today: "Today",
        upcoming: "Upcoming",
        logbook: "Logbook"
      };

      function todayStr(): string {
        const d = new Date();
        const pad = (n: number) => String(n).padStart(2, "0");
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      }

      function makeId(): string {
        return `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
      }

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;"
        })[c] as string);
      }

      async function apiFetch(method: "GET" | "POST", body?: unknown, url: string = API) {
        const token = localStorage.getItem(TOKEN_KEY);
        const res = await fetch(url, {
          method,
          headers: {
            "Content-Type": "application/json",
            "x-punkt-token": token || ""
          },
          body: body ? JSON.stringify(body) : undefined
        });
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          showGate("Fel åtkomstkod.");
          throw new Error("unauthorized");
        }
        if (!res.ok) {
          let detail = "";
          try {
            detail = (await res.json()).error || "";
          } catch {
            // response wasn't JSON — leave detail blank
          }
          throw new Error(`API error ${res.status}${detail ? `: ${detail}` : ""}`);
        }
        return res.json();
      }

      /**
       * Converts the base64url VAPID public key into the Uint8Array
       * shape PushManager.subscribe() expects.
       */
      function urlBase64ToUint8Array(base64: string): Uint8Array {
        const padding = "=".repeat((4 - (base64.length % 4)) % 4);
        const base64Safe = (base64 + padding).replace(/-/g, "+").replace(/_/g, "/");
        const raw = atob(base64Safe);
        return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
      }

      /**
       * Asks for notification permission (if needed) and registers a
       * push subscription with the server. Called the first time the
       * user sets a reminder — a natural moment to ask, since that's
       * exactly when a notification becomes relevant.
       */
      async function ensurePushSubscription() {
        if (!VAPID_PUBLIC_KEY || !("serviceWorker" in navigator) || !("PushManager" in window)) {
          return;
        }
        try {
          const registration = await navigator.serviceWorker.ready;
          let subscription = await registration.pushManager.getSubscription();
          if (!subscription) {
            const permission = await Notification.requestPermission();
            if (permission !== "granted") return;
            subscription = await registration.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
            });
          }
          await apiFetch("POST", { subscription: subscription.toJSON() }, SUBSCRIBE_API);
        } catch (err) {
          console.warn("Punkt: push subscription failed", err);
        }
      }

      function showGate(message = "") {
        app.hidden = true;
        gate.hidden = false;
        gateError.textContent = message;
      }

      function showApp() {
        gate.hidden = true;
        app.hidden = false;
      }

      function showSaveError(message: string) {
        saveErrorText.textContent = `Kunde inte spara: ${message}`;
        saveError.hidden = false;
      }

      function hideSaveError() {
        saveError.hidden = true;
      }

      saveErrorRetry.addEventListener("click", () => {
        hideSaveError();
        queueSave();
      });

      async function loadTasks() {
        const data = await apiFetch("GET");
        tasks = data.tasks || [];
        renderMenu();
      }

      function queueSave() {
        if (saveInFlight) {
          saveQueued = true;
          return;
        }
        saveInFlight = true;
        apiFetch("POST", { tasks })
          .then(() => hideSaveError())
          .catch((err) => {
            console.error("Punkt: failed to save tasks", err);
            showSaveError(err.message);
          })
          .finally(() => {
            saveInFlight = false;
            if (saveQueued) {
              saveQueued = false;
              queueSave();
            }
          });
      }

      function bucket(view: View): Task[] {
        const today = todayStr();
        if (view === "inbox") return tasks.filter((t) => !t.done && !t.when);
        if (view === "today")
          return tasks.filter((t) => !t.done && t.when && (t.when === "today" || t.when <= today));
        if (view === "upcoming")
          return tasks
            .filter((t) => !t.done && t.when && t.when !== "today" && t.when > today)
            .sort((a, b) => (a.when! < b.when! ? -1 : 1));
        if (view === "logbook")
          return tasks
            .filter((t) => t.done)
            .sort((a, b) => (b.completedAt || "").localeCompare(a.completedAt || ""));
        return [];
      }

      function renderMenu() {
        const rows: { view: Exclude<View, "menu">; label: string; iconHtml: string; iconClass: string }[] = [
          { view: "inbox", label: "Inbox", iconHtml: ICON_INBOX, iconClass: "menu-icon--inbox" },
          { view: "today", label: "Today", iconHtml: "★", iconClass: "menu-icon--today" },
          { view: "upcoming", label: "Upcoming", iconHtml: ICON_UPCOMING, iconClass: "menu-icon--upcoming" },
          { view: "logbook", label: "Logbook", iconHtml: ICON_LOGBOOK, iconClass: "menu-icon--logbook" }
        ];
        menuList.innerHTML = rows
          .map(
            (r) => `
          <button class="menu-row" data-nav="${r.view}">
            <span class="menu-icon ${r.iconClass}">${r.iconHtml}</span>
            <span class="menu-label">${r.label}</span>
            <span class="menu-count">${bucket(r.view).length}</span>
          </button>`
          )
          .join("");
      }

      function taskRowHtml(task: Task, dateBadge?: string): string {
        const icons: string[] = [];
        if (task.note) icons.push(ICON_NOTE);
        if (!task.done && task.remind && task.notifiedOn !== todayStr()) icons.push(ICON_BELL);
        if (!task.done && task.deadline) icons.push(ICON_FLAG);
        const selected = selectedIds.has(task.id);
        const indicator = selectMode
          ? `<span class="select-circle ${selected ? "selected" : ""}"></span>`
          : `<input type="checkbox" class="task-check" data-action="toggle" data-id="${task.id}" ${task.done ? "checked" : ""} />`;
        return `
          <li class="task-row ${task.done ? "done" : ""} ${selectMode && selected ? "row-selected" : ""}" data-id="${task.id}">
            <div class="task-title-line">
              ${indicator}
              <span class="task-title-content">
                ${dateBadge ? `<span class="task-date-badge">${dateBadge}</span>` : ""}
                <span class="task-title">${escapeHtml(task.title)}</span>
                ${icons.join("")}
              </span>
            </div>
            ${task.note ? `<div class="task-note">${escapeHtml(task.note)}</div>` : ""}
          </li>`;
      }

      /** "5/9" style compact date, matching Things' Logbook rows. */
      function formatCompactDate(dateStr: string): string {
        const [, month, day] = dateStr.split("-").map(Number);
        return `${day}/${month}`;
      }

      /** Groups Logbook entries the way Things does: Today, Yesterday,
       *  then by month (with the year appended once it's not this year). */
      function logbookGroupLabel(dateStr: string, todayStr: string): string {
        const date = new Date(`${dateStr}T00:00:00`);
        const today = new Date(`${todayStr}T00:00:00`);
        const diffDays = Math.round((today.getTime() - date.getTime()) / 86400000);
        if (diffDays === 0) return "Today";
        if (diffDays === 1) return "Yesterday";
        const sameYear = date.getFullYear() === today.getFullYear();
        const month = date.toLocaleDateString("en-US", { month: "long" });
        return sameYear ? month : `${month} ${date.getFullYear()}`;
      }

      /** Label next to the big day number in Upcoming: "Tomorrow" for
       *  the next day, the weekday name for the rest of this week, else
       *  the month (year appended once it's not this year). */
      function upcomingGroupLabel(dateStr: string, todayStr: string): string {
        const date = new Date(`${dateStr}T00:00:00`);
        const today = new Date(`${todayStr}T00:00:00`);
        const diffDays = Math.round((date.getTime() - today.getTime()) / 86400000);
        if (diffDays === 1) return "Tomorrow";
        if (diffDays > 1 && diffDays < 7) return date.toLocaleDateString("en-US", { weekday: "long" });
        const sameYear = date.getFullYear() === today.getFullYear();
        const month = date.toLocaleDateString("en-US", { month: "short" });
        return sameYear ? month : `${month} ${date.getFullYear()}`;
      }

      function renderTaskList() {
        // #quick-add can currently be a child of taskListEl (moved
        // there to sit inline where an edited row was) — innerHTML
        // below would destroy it if we didn't move it out first.
        // openTaskEdit() re-parents it back into place afterward.
        if (quickAdd.parentElement === taskListEl) {
          quickAddAnchor.insertAdjacentElement("afterend", quickAdd);
        }

        // Hide the row being edited — the quick-add card takes its
        // place inline instead.
        const items = bucket(currentView as View).filter((t) => t.id !== editingTaskId);

        // While editing the only task in a view, `items` becomes empty
        // even though the list isn't really empty — the quick-add card
        // is about to occupy that slot inline, so the "nothing here"
        // message must stay out of its way.
        const showEmptyState = !editingTaskId;

        if (currentView === "upcoming") {
          if (items.length === 0) {
            taskListEl.innerHTML = showEmptyState ? '<p class="empty">Inget schemalagt.</p>' : "";
            return;
          }
          const today = todayStr();
          let lastDate = "";
          taskListEl.innerHTML = items
            .map((t) => {
              let heading = "";
              if (t.when !== lastDate) {
                const date = new Date(`${t.when}T00:00:00`);
                heading = `
                  <div class="date-group upcoming">
                    <span class="upcoming-day-num">${date.getDate()}</span>
                    <span class="upcoming-day-label">${upcomingGroupLabel(t.when!, today)}</span>
                    <span class="upcoming-day-rule"></span>
                  </div>`;
              }
              lastDate = t.when!;
              return heading + taskRowHtml(t);
            })
            .join("");
          return;
        }

        if (currentView === "logbook") {
          if (items.length === 0) {
            taskListEl.innerHTML = showEmptyState ? '<p class="empty">Inget avklarat än.</p>' : "";
            return;
          }
          const today = todayStr();
          let lastLabel = "";
          taskListEl.innerHTML = items
            .map((t) => {
              const day = (t.completedAt || "").slice(0, 10);
              const label = logbookGroupLabel(day, today);
              const heading = label !== lastLabel ? `<div class="date-group">${label}</div>` : "";
              lastLabel = label;
              return heading + taskRowHtml(t, formatCompactDate(day));
            })
            .join("");
          return;
        }

        const emptyLabel = currentView === "inbox" ? "Inboxen är tom." : "Inget för idag.";
        taskListEl.innerHTML =
          items.map((t) => taskRowHtml(t)).join("") || (showEmptyState ? `<p class="empty">${emptyLabel}</p>` : "");
      }

      function findTask(id: string): Task | undefined {
        return tasks.find((t) => t.id === id);
      }

      let hasShownScreenOnce = false;

      /**
       * Slides `incoming` in over `outgoing`, both full-width — "forward"
       * (menu -> a list) brings the new screen in from the right while
       * the old one exits left; "backward" (a list -> menu) is the
       * mirror image, matching a standard iOS push/pop transition.
       */
      function slideScreens(outgoing: HTMLElement, incoming: HTMLElement, direction: "forward" | "backward") {
        const outTarget = direction === "forward" ? "-100%" : "100%";
        const inStart = direction === "forward" ? "100%" : "-100%";

        outgoing.classList.add("sliding");
        incoming.classList.add("sliding");
        incoming.hidden = false;
        incoming.style.transition = "none";
        incoming.style.transform = `translateX(${inStart})`;
        void incoming.offsetWidth; // force reflow so the transition below actually animates

        outgoing.style.transition = "";
        incoming.style.transition = "";

        requestAnimationFrame(() => {
          outgoing.style.transform = `translateX(${outTarget})`;
          incoming.style.transform = "translateX(0)";
        });

        const onDone = (e: TransitionEvent) => {
          if (e.target !== outgoing) return;
          outgoing.hidden = true;
          outgoing.classList.remove("sliding");
          incoming.classList.remove("sliding");
          outgoing.style.transform = "";
          incoming.style.transform = "";
          outgoing.removeEventListener("transitionend", onDone);
        };
        outgoing.addEventListener("transitionend", onDone);
      }

      function navigateTo(view: View) {
        const previousView = currentView;
        currentView = view;
        exitSelectMode();
        const animate = hasShownScreenOnce && previousView !== view;
        hasShownScreenOnce = true;

        if (view === "menu") {
          closeQuickAdd();
          renderMenu();
          if (animate) {
            slideScreens(viewList, viewMenu, "backward");
          } else {
            viewList.hidden = true;
            viewMenu.hidden = false;
          }
          return;
        }

        listTitle.textContent = VIEW_TITLES[view];
        addBtn.hidden = view === "logbook";
        renderTaskList();

        if (animate && previousView === "menu") {
          slideScreens(viewMenu, viewList, "forward");
        } else {
          viewMenu.hidden = true;
          viewList.hidden = false;
        }
      }

      menuList.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest("[data-nav]") as HTMLElement | null;
        if (btn) navigateTo(btn.dataset.nav as View);
      });

      backBtn.addEventListener("click", () => navigateTo("menu"));

      // Rows pending removal from the current view (checked off in
      // Today/Inbox/Upcoming, or unchecked in Logbook) — held here so a
      // second toggle before the fade fires can cancel it.
      const pendingRowRemovals = new Map<string, number>();

      taskListEl.addEventListener("change", (e) => {
        const target = e.target as HTMLElement;
        if (target.dataset.action !== "toggle") return;
        const id = target.dataset.id!;
        const task = findTask(id);
        if (!task) return;
        const checked = (target as HTMLInputElement).checked;
        task.done = checked;
        task.completedAt = checked ? new Date().toISOString() : null;
        renderMenu();
        queueSave();

        const existingTimeout = pendingRowRemovals.get(id);
        if (existingTimeout) {
          clearTimeout(existingTimeout);
          pendingRowRemovals.delete(id);
        }

        const row = target.closest(".task-row") as HTMLElement | null;
        if (!row) {
          renderTaskList();
          return;
        }

        // Show the checked/unchecked state immediately...
        row.classList.toggle("done", checked);
        row.classList.remove("row-pending-removal", "row-fade-out");
        row.querySelectorAll<HTMLInputElement>(".task-check").forEach((cb) => (cb.checked = checked));

        const stillBelongsHere = bucket(currentView as View).some((t) => t.id === id);
        if (!stillBelongsHere) {
          // ...highlight it as "about to leave this view"...
          row.classList.add("row-pending-removal");
          // ...then, a beat later, fade it out and only re-render (which
          // actually removes it, since it no longer matches this view)
          // once the fade has finished.
          const timeoutId = window.setTimeout(() => {
            pendingRowRemovals.delete(id);
            row.classList.add("row-fade-out");
            window.setTimeout(() => renderTaskList(), 320);
          }, 1200);
          pendingRowRemovals.set(id, timeoutId);
        }
      });

      // --- Swipe-to-select (Things-style multi-select) --------------------

      function enterSelectMode(id: string) {
        if (selectMode) return;
        selectMode = true;
        selectedIds = new Set([id]);
        closeQuickAdd();
        backBtn.hidden = true;
        addBtn.hidden = true;
        doneBtn.hidden = false;
        selectBar.hidden = false;
        document.body.classList.add("select-mode");
        renderTaskList();
      }

      function exitSelectMode() {
        const wasSelecting = selectMode;
        selectMode = false;
        selectedIds = new Set();
        whenPanel.hidden = true;
        selectBar.hidden = true;
        doneBtn.hidden = true;
        backBtn.hidden = false;
        addBtn.hidden = currentView === "logbook";
        document.body.classList.remove("select-mode");
        if (wasSelecting) renderTaskList();
      }

      doneBtn.addEventListener("click", exitSelectMode);

      let suppressNextClick = false;

      taskListEl.addEventListener("click", (e) => {
        if (suppressNextClick) {
          suppressNextClick = false;
          return;
        }
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement | null;
        if (!row) return;
        const id = row.dataset.id!;

        if (selectMode) {
          if (selectedIds.has(id)) selectedIds.delete(id);
          else selectedIds.add(id);
          renderTaskList();
          return;
        }

        // The checkbox has its own "change" handler for toggling done —
        // tapping the rest of the row opens the task for editing.
        if ((e.target as HTMLElement).closest(".task-check")) return;
        const task = findTask(id);
        if (task) openTaskEdit(task);
      });

      let swipeActive = false;
      let swipeTriggered = false;
      let swipeStartX = 0;
      let swipeStartY = 0;
      let swipeRowId: string | null = null;

      taskListEl.addEventListener("pointerdown", (e) => {
        if (selectMode) return;
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement | null;
        if (!row) return;
        swipeActive = true;
        swipeTriggered = false;
        swipeStartX = (e as PointerEvent).clientX;
        swipeStartY = (e as PointerEvent).clientY;
        swipeRowId = row.dataset.id || null;
      });

      taskListEl.addEventListener("pointermove", (e) => {
        if (!swipeActive || swipeTriggered || !swipeRowId) return;
        const dx = (e as PointerEvent).clientX - swipeStartX;
        const dy = (e as PointerEvent).clientY - swipeStartY;
        if (Math.abs(dx) > 28 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          swipeTriggered = true;
          suppressNextClick = true;
          enterSelectMode(swipeRowId);
        }
      });

      function endSwipe() {
        swipeActive = false;
        swipeRowId = null;
        if (swipeTriggered) {
          // If the browser follows this drag with a synthetic click, it
          // fires synchronously and consumes the flag itself. If not,
          // clear it shortly after so the *next* real tap isn't swallowed.
          setTimeout(() => {
            suppressNextClick = false;
          }, 0);
        }
      }
      taskListEl.addEventListener("pointerup", endSwipe);
      taskListEl.addEventListener("pointercancel", endSwipe);

      function applyWhenToSelected(when: string | null) {
        for (const id of selectedIds) {
          const t = findTask(id);
          if (t) t.when = when;
        }
        renderMenu();
        queueSave();
        whenPanel.hidden = true;
        exitSelectMode();
      }

      sbWhen.addEventListener("click", () => {
        whenPanel.hidden = !whenPanel.hidden;
      });

      wpToday.addEventListener("click", () => applyWhenToSelected("today"));
      wpInbox.addEventListener("click", () => applyWhenToSelected(null));
      wpDate.addEventListener("change", () => {
        if (wpDate.value) applyWhenToSelected(wpDate.value);
      });

      sbDelete.addEventListener("click", () => {
        if (selectedIds.size === 0) return;
        const count = selectedIds.size;
        if (!confirm(count === 1 ? "Ta bort uppgiften?" : `Ta bort ${count} uppgifter?`)) return;
        tasks = tasks.filter((t) => !selectedIds.has(t.id));
        renderMenu();
        queueSave();
        exitSelectMode();
      });

      // --- Quick add / task edit -------------------------------------

      // The task being composed doesn't exist yet, so its when/remind
      // choice is held here while the "When?"/"Add Reminder" sheets are
      // open, then applied to the new task on commit. The same card and
      // pending vars are reused to edit an existing task — editingTaskId
      // tracks which mode we're in.
      let pendingWhen: string | null = null;
      let pendingRemind: string | null = null;
      let pendingWhenChoice: "today" | "evening" | "date" | null = null;
      let editingTaskId: string | null = null;

      const ICON_BELL_SMALL = ICON_BELL;

      /**
       * Updates the "active" tint on the when-button, and — only once a
       * reminder time is actually set — shows a small context label
       * ("★ Today 🔔13:00") so an edited task's schedule is visible
       * without needing to reopen the When? sheet.
       */
      function updateQaFooter() {
        qaWhenBtn.classList.toggle("active", pendingWhen !== null || pendingRemind !== null);

        if (!pendingRemind) {
          qaContext.hidden = true;
          qaContext.innerHTML = "";
          return;
        }

        let whenLabel = "";
        if (pendingWhenChoice === "today") whenLabel = '<span class="star">★</span> Today';
        else if (pendingWhenChoice === "evening") whenLabel = "🌙 This Evening";
        else if (pendingWhen) whenLabel = escapeHtml(pendingWhen);
        qaContext.innerHTML = `${whenLabel} ${ICON_BELL_SMALL}${pendingRemind}`;
        qaContext.hidden = false;
      }

      /** Moves the (single, shared) quick-add form back to its default
       *  spot above the list, out of taskListEl. */
      function resetQuickAddPosition() {
        quickAddAnchor.insertAdjacentElement("afterend", quickAdd);
      }

      /** Re-parents the quick-add form into taskListEl right where the
       *  edited task's row would be, so it opens inline instead of
       *  floating above the list. */
      function placeQuickAddInline(taskId: string) {
        const items = bucket(currentView as View);
        const index = items.findIndex((t) => t.id === taskId);
        const nextTask = index === -1 ? undefined : items[index + 1];
        const nextRow = nextTask
          ? (taskListEl.querySelector(`.task-row[data-id="${nextTask.id}"]`) as HTMLElement | null)
          : null;
        if (nextRow) {
          taskListEl.insertBefore(quickAdd, nextRow);
        } else {
          taskListEl.appendChild(quickAdd);
        }
      }

      /** Plays the card's "lift off the list" entrance: pops in from
       *  slightly scaled-down and transparent to full size, so the
       *  drop shadow above and below it reads as it rising off the
       *  flat list rather than just appearing. */
      function playCardOpenAnimation() {
        quickAdd.style.transition = "none";
        quickAdd.style.transform = "scale(0.96)";
        quickAdd.style.opacity = "0";
        void quickAdd.offsetWidth; // force reflow so the transition below actually animates
        quickAdd.style.transition = "";
        requestAnimationFrame(() => {
          quickAdd.style.transform = "scale(1)";
          quickAdd.style.opacity = "1";
        });
      }

      function openQuickAdd() {
        editingTaskId = null;
        resetQuickAddPosition();
        quickAdd.hidden = false;
        quickAddScrim.hidden = false;
        playCardOpenAnimation();
        qaCheckbox.checked = false;
        qaTitle.value = "";
        qaNote.value = "";

        if (currentView === "today") {
          pendingWhen = "today";
          pendingWhenChoice = "today";
        } else {
          pendingWhen = null;
          pendingWhenChoice = null;
        }
        pendingRemind = null;
        updateQaFooter();

        qaTitle.focus();
      }

      function openTaskEdit(task: Task) {
        editingTaskId = task.id;
        qaCheckbox.checked = task.done;
        qaTitle.value = task.title;
        qaNote.value = task.note;
        pendingWhen = task.when;
        pendingRemind = task.remind;
        pendingWhenChoice =
          task.when === "today" ? (task.remind === "18:00" ? "evening" : "today") : task.when ? "date" : null;
        updateQaFooter();
        renderTaskList();
        placeQuickAddInline(task.id);
        quickAdd.hidden = false;
        quickAddScrim.hidden = false;
        playCardOpenAnimation();
        qaTitle.focus();
      }

      function closeQuickAdd() {
        if (editingTaskId) {
          commitQuickAdd();
          return;
        }
        quickAdd.hidden = true;
        quickAddScrim.hidden = true;
        whenSheet.hidden = true;
        reminderSheet.hidden = true;
      }

      quickAddScrim.addEventListener("click", closeQuickAdd);

      qaCheckbox.addEventListener("change", () => {
        if (!editingTaskId) return;
        const task = findTask(editingTaskId);
        if (!task) return;
        const title = qaTitle.value.trim();
        if (title) task.title = title;
        task.note = qaNote.value.trim();
        task.when = pendingWhen;
        task.remind = pendingRemind;
        task.done = qaCheckbox.checked;
        task.completedAt = task.done ? new Date().toISOString() : null;
        editingTaskId = null;
        quickAdd.hidden = true;
        quickAddScrim.hidden = true;
        whenSheet.hidden = true;
        reminderSheet.hidden = true;
        renderTaskList();
        renderMenu();
        queueSave();
      });

      addBtn.addEventListener("click", () => {
        if (quickAdd.hidden) openQuickAdd();
        else closeQuickAdd();
      });

      // Adding from the root list-picker has no "current view" to add
      // into, so it defaults to Inbox — same as tapping + there.
      menuAddBtn.addEventListener("click", () => {
        navigateTo("inbox");
        openQuickAdd();
      });

      // --- "When?" sheet ---------------------------------------------

      let calendarViewYear = 0;
      let calendarViewMonth = 0; // 0-indexed

      function renderCalendar() {
        const first = new Date(calendarViewYear, calendarViewMonth, 1);
        const startWeekday = (first.getDay() + 6) % 7; // 0 = Monday
        const daysInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate();
        const today = todayStr();
        const pad = (n: number) => String(n).padStart(2, "0");

        calMonthName.textContent = first.toLocaleDateString("sv-SE", {
          month: "long",
          year: "numeric"
        });

        const cells: string[] = [];
        for (let i = 0; i < startWeekday; i++) cells.push("<span></span>");
        for (let d = 1; d <= daysInMonth; d++) {
          const dateStr = `${calendarViewYear}-${pad(calendarViewMonth + 1)}-${pad(d)}`;
          const isToday = dateStr === today;
          const isSelected = pendingWhenChoice === "date" && pendingWhen === dateStr;
          cells.push(
            `<button type="button" class="cal-day ${isSelected ? "selected" : ""}" data-date="${dateStr}">${d}${
              isToday ? '<span class="cal-today-mark">★</span>' : ""
            }</button>`
          );
        }
        calGrid.innerHTML = cells.join("");
      }

      function updateWhenSheetChecks() {
        whenSheet.querySelectorAll<HTMLElement>("[data-check]").forEach((el) => {
          el.classList.toggle("checked", el.dataset.check === pendingWhenChoice);
        });
        whenReminderLabel.textContent = pendingRemind || "";
      }

      function openWhenSheet() {
        const now = new Date();
        calendarViewYear = now.getFullYear();
        calendarViewMonth = now.getMonth();
        renderCalendar();
        updateWhenSheetChecks();
        whenSheet.hidden = false;
      }

      qaWhenBtn.addEventListener("click", openWhenSheet);
      whenSheetClose.addEventListener("click", () => {
        whenSheet.hidden = true;
      });

      whenSheet.addEventListener("click", (e) => {
        if (e.target === whenSheet) {
          whenSheet.hidden = true;
          return;
        }

        const choiceBtn = (e.target as HTMLElement).closest("[data-when-choice]") as HTMLElement | null;
        if (choiceBtn) {
          const choice = choiceBtn.dataset.whenChoice;
          if (choice === "today") {
            pendingWhen = "today";
            pendingWhenChoice = "today";
            pendingRemind = null;
          } else if (choice === "evening") {
            pendingWhen = "today";
            pendingWhenChoice = "evening";
            pendingRemind = "18:00";
          }
          updateQaFooter();
          whenSheet.hidden = true;
          return;
        }

        const dayBtn = (e.target as HTMLElement).closest(".cal-day") as HTMLElement | null;
        if (dayBtn) {
          pendingWhen = dayBtn.dataset.date || null;
          pendingWhenChoice = "date";
          pendingRemind = null;
          updateQaFooter();
          whenSheet.hidden = true;
        }
      });

      calPrev.addEventListener("click", () => {
        calendarViewMonth -= 1;
        if (calendarViewMonth < 0) {
          calendarViewMonth = 11;
          calendarViewYear -= 1;
        }
        renderCalendar();
      });

      calNext.addEventListener("click", () => {
        calendarViewMonth += 1;
        if (calendarViewMonth > 11) {
          calendarViewMonth = 0;
          calendarViewYear += 1;
        }
        renderCalendar();
      });

      whenClear.addEventListener("click", () => {
        pendingWhen = null;
        pendingWhenChoice = null;
        pendingRemind = null;
        updateQaFooter();
        whenSheet.hidden = true;
      });

      // --- "Add Reminder" sheet ---------------------------------------

      whenAddReminder.addEventListener("click", () => {
        if (!pendingWhen) {
          pendingWhen = "today";
          pendingWhenChoice = "today";
        }
        const defaultTime = new Date(Date.now() + 60 * 60 * 1000);
        const pad = (n: number) => String(n).padStart(2, "0");
        reminderTimeInput.value =
          pendingRemind || `${pad(defaultTime.getHours())}:${pad(defaultTime.getMinutes())}`;
        whenSheet.hidden = true;
        reminderSheet.hidden = false;
      });

      reminderCancel.addEventListener("click", () => {
        reminderSheet.hidden = true;
        whenSheet.hidden = false;
      });

      reminderSheet.addEventListener("click", (e) => {
        if (e.target === reminderSheet) reminderCancel.click();
      });

      reminderSet.addEventListener("click", () => {
        if (reminderTimeInput.value) {
          pendingRemind = reminderTimeInput.value;
          updateQaFooter();
          void ensurePushSubscription();
        }
        reminderSheet.hidden = true;
        // Setting a reminder is a natural "I'm done configuring this"
        // moment — commit right away instead of waiting for a separate
        // Enter, so the task visibly lands in the list as confirmation
        // the reminder was actually set.
        commitQuickAdd();
      });

      function commitQuickAdd() {
        const title = qaTitle.value.trim();

        if (editingTaskId) {
          const task = findTask(editingTaskId);
          if (task) {
            if (title) task.title = title;
            task.note = qaNote.value.trim();
            task.when = pendingWhen;
            task.remind = pendingRemind;
          }
          editingTaskId = null;
          quickAdd.hidden = true;
          quickAddScrim.hidden = true;
          whenSheet.hidden = true;
          reminderSheet.hidden = true;
          if (task) {
            renderTaskList();
            renderMenu();
            queueSave();
          }
          return;
        }

        if (!title) return;

        if (currentView === "upcoming" && (!pendingWhen || pendingWhen === "today")) {
          openWhenSheet();
          return;
        }

        tasks.push({
          id: makeId(),
          title,
          note: qaNote.value.trim(),
          when: pendingWhen,
          deadline: null,
          remind: pendingRemind,
          notifiedOn: null,
          done: false,
          completedAt: null
        });

        renderTaskList();
        renderMenu();
        queueSave();

        // Things-style rapid entry: clear and keep the card open for
        // the next to-do instead of closing it. The when/reminder
        // choice intentionally carries over to the next to-do.
        qaTitle.value = "";
        qaNote.value = "";
        qaTitle.focus();
      }

      // A real <form> submit (rather than only listening for a keydown
      // Enter on the title input) is what reliably fires when the
      // return key on iOS's on-screen keyboard is pressed.
      quickAdd.addEventListener("submit", (e) => {
        e.preventDefault();
        commitQuickAdd();
      });

      quickAdd.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeQuickAdd();
      });

      // --- Gate + boot -----------------------------------------------------

      gateForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        localStorage.setItem(TOKEN_KEY, gateInput.value);
        gateError.textContent = "";
        try {
          await loadTasks();
          showApp();
          navigateTo("today");
        } catch {
          if (!gate.hidden) gateError.textContent = "Kunde inte ansluta. Försök igen.";
        }
      });

      (async function initServiceWorker() {
        if (!("serviceWorker" in navigator)) return;
        navigator.serviceWorker.register("/punkt/sw.js").catch((err) => {
          console.warn("Punkt: service worker registration failed", err);
        });
      })();

      (async function boot() {
        if (localStorage.getItem(TOKEN_KEY)) {
          try {
            await loadTasks();
            showApp();
            navigateTo("today");
            return;
          } catch {
            // fall through to gate
          }
        }
        showGate();
      })();
    </script>
  </body>
</html>
