---
// Punkt is a standalone mini-app, deliberately not using the site's
// shared Layout.astro: it needs its own manifest/start_url/scope so
// "Add to Home Screen" installs *this* app, not fridgren.se.

// Public (non-secret) VAPID key, embedded at build time so the client
// can call pushManager.subscribe() without a round-trip to a function.
const vapidPublicKey = import.meta.env.PUBLIC_PUNKT_VAPID_KEY ?? "";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Punkt</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111827" />
    <link rel="manifest" href="/punkt/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/punkt/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Punkt" />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #111827;
        --surface: #1b2333;
        --border: #2c3650;
        --text: #f3f4f6;
        --muted: #9aa4b8;
        --accent: #6ea8fe;
        --danger: #f87171;
        --gold: #f5c518;
        --blue-badge: #3b7bf0;
        --red-badge: #ef5b7a;
        --green-badge: #34c759;
        --hairline: rgba(255, 255, 255, 0.06);
        --select-tint: rgba(110, 168, 254, 0.18);
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg: #ffffff;
          --surface: #f5f5f7;
          --border: #e3e3e7;
          --text: #1c1c1e;
          --muted: #8a8a8e;
          --accent: #2f6fed;
          --danger: #dc2626;
          --hairline: rgba(0, 0, 0, 0.08);
          --select-tint: rgba(47, 111, 237, 0.12);
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        /* Kills the elastic rubber-band bounce at the top/bottom of the
           page on iOS — native apps don't wobble when there's nothing
           left to scroll, and neither should this. */
        overscroll-behavior-y: none;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        overflow-x: hidden;
        overscroll-behavior-y: none;
      }

      /* Reserves room for the floating select-bar pill only while it's
         actually shown — applying this unconditionally made the page
         scrollable by that much even on short lists with nothing to
         scroll to, which reads as a rubber-band-y web page rather than
         a native list. */
      body.select-mode {
        padding-bottom: calc(4rem + env(safe-area-inset-bottom));
      }

      #app {
        position: relative;
        min-height: 100vh;
      }

      #gate {
        max-width: 22rem;
        margin: calc(4rem + env(safe-area-inset-top)) auto 0;
        padding: 0 1rem;
      }

      #gate form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      button {
        font: inherit;
        color: inherit;
        background: none;
        border: none;
        cursor: pointer;
      }

      input,
      select {
        font: inherit;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.5rem 0.6rem;
        width: 100%;
      }

      .screen {
        max-width: 32rem;
        margin: 0 auto;
        padding: calc(1.25rem + env(safe-area-inset-top)) 1rem 3rem;
      }

      .screen.sliding {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        transition: transform 0.28s ease;
      }

      /* --- Menu (root) screen -------------------------------------- */

      .menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
      }

      .menu-header h1 {
        font-size: 1.7rem;
        margin: 0;
      }

      .save-error {
        position: fixed;
        bottom: calc(1.25rem + env(safe-area-inset-bottom));
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 30rem);
        background: var(--danger);
        color: #1a0a0a;
        border-radius: 0.7rem;
        padding: 0.6rem 0.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        font-size: 0.85rem;
        z-index: 40;
      }

      .save-error button {
        font-weight: 600;
        text-decoration: underline;
        flex-shrink: 0;
      }

      #menu-list {
        display: flex;
        flex-direction: column;
      }

      .menu-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 0.25rem;
        border-radius: 0.6rem;
        text-align: left;
        width: 100%;
      }

      .menu-row:active {
        background: var(--surface);
      }

      .menu-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .menu-icon svg {
        width: 16px;
        height: 16px;
        color: white;
      }

      .menu-icon--inbox {
        background: var(--blue-badge);
      }
      .menu-icon--upcoming {
        background: var(--red-badge);
      }
      .menu-icon--logbook {
        background: var(--green-badge);
      }
      .menu-icon--today {
        background: none;
        font-size: 1.5rem;
        color: var(--gold);
      }

      .menu-label {
        flex: 1;
        font-size: 1.05rem;
      }

      .menu-count {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* --- List (detail) screen -------------------------------------- */

      .list-header {
        position: relative;
        z-index: 17;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .list-header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      #back-btn {
        color: var(--muted);
        display: flex;
        padding: 0.25rem 0.25rem 0.25rem 0;
      }

      #back-btn svg {
        width: 30px;
        height: 30px;
      }

      #list-title {
        font-size: 1.4rem;
        margin: 0;
      }

      .fab {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        background: var(--accent);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .fab svg {
        width: 24px;
        height: 24px;
        display: block;
      }

      .fab:active {
        opacity: 0.8;
      }

      .fab[hidden] {
        display: none;
      }

      .list-header-right {
        display: flex;
        align-items: center;
      }

      .done-pill {
        background: var(--accent);
        color: #0b1220;
        font-weight: 600;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
      }

      /* Quick-add card: fields have no visible box of their own — just
         a faintly elevated card so they read as "almost invisible". */
      #quick-add {
        position: relative;
        z-index: 16;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.9rem;
        padding: 0.85rem 1rem;
        margin-bottom: 1.25rem;
        box-shadow:
          0 -10px 24px -8px rgba(0, 0, 0, 0.28),
          0 10px 24px -8px rgba(0, 0, 0, 0.28);
        transform: scale(1);
        opacity: 1;
        transition:
          transform 0.22s cubic-bezier(0.2, 0.8, 0.3, 1),
          opacity 0.22s ease;
      }

      #quick-add-scrim {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 15;
      }

      #quick-add .qa-title-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--hairline);
      }

      #quick-add input:not(.task-check) {
        background: transparent;
        border: none;
        padding: 0;
        width: 100%;
      }

      #quick-add input:focus {
        outline: none;
      }

      #quick-add input::placeholder {
        color: var(--muted);
      }

      #qa-title {
        font-size: 1.05rem;
      }

      #quick-add #qa-note {
        /* Must stay >= 16px — anything smaller makes iOS Safari
           auto-zoom the whole page in on focus, and in standalone PWA
           mode it sometimes fails to zoom back out cleanly afterwards,
           which shows up as the next screen briefly rendering zoomed
           out before snapping to the correct scale. */
        font-size: 1rem;
        color: var(--muted);
        padding: 0.85rem 0 0.1rem 1.75rem;
      }

      .qa-footer {
        display: flex;
        align-items: center;
        margin-top: 0.5rem;
        padding-left: 1.75rem;
        gap: 0.5rem;
      }

      .qa-context {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .qa-context .star {
        color: var(--gold);
      }

      .qa-context svg {
        width: 14px;
        height: 14px;
        display: block;
      }

      .qa-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-left: auto;
      }

      .ghost-icon {
        color: var(--muted);
        padding: 0.2rem;
        border-radius: 0.4rem;
      }

      .ghost-icon.active {
        color: var(--accent);
      }

      .ghost-icon svg {
        width: 17px;
        height: 17px;
        display: block;
      }

      .qa-date {
        width: auto;
        background: transparent;
        border: none;
        color: var(--text);
        font-size: 0.85rem;
        padding: 0;
      }

      /* --- Flat task list, matching Things' plain rows --------------- */

      #task-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      li.task-row {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.55rem 0.5rem;
        margin: 0 -0.5rem;
        border-radius: 0.6rem;
        touch-action: pan-y;
        transition:
          opacity 0.3s ease,
          background 0.2s ease;
      }

      li.task-row.row-fade-out {
        opacity: 0;
      }

      li.task-row.row-pending-removal {
        background: var(--surface);
      }

      li.task-row.row-selected {
        background: var(--select-tint);
      }

      .select-circle {
        width: 20px;
        height: 20px;
        border: 2px solid var(--muted);
        border-radius: 50%;
        flex-shrink: 0;
        display: grid;
        place-content: center;
      }

      .select-circle.selected {
        background: var(--accent);
        border-color: var(--accent);
      }

      .select-circle.selected::after {
        content: "";
        width: 5px;
        height: 9px;
        border: solid #0b1220;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -1px);
      }

      .select-bar,
      .when-panel {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 30rem);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        z-index: 20;
      }

      .select-bar {
        bottom: calc(1.25rem + env(safe-area-inset-bottom));
        display: flex;
        justify-content: space-around;
        padding: 0.55rem 0.5rem;
      }

      .select-bar[hidden] {
        display: none;
      }

      .select-bar-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        font-size: 0.7rem;
        color: var(--accent);
        padding: 0.2rem 0.75rem;
      }

      .select-bar-btn svg {
        width: 20px;
        height: 20px;
      }

      .select-bar-btn.danger {
        color: var(--danger);
      }

      .when-panel {
        bottom: calc(4.75rem + env(safe-area-inset-bottom));
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
      }

      .when-panel[hidden] {
        display: none;
      }

      .when-panel button {
        color: var(--accent);
        padding: 0.3rem 0.5rem;
      }

      .when-panel input[type="date"] {
        width: auto;
        background: transparent;
        border: none;
        color: var(--text);
        padding: 0;
      }

      .task-check {
        -webkit-appearance: none;
        appearance: none;
        box-sizing: border-box;
        width: 20px;
        height: 20px;
        min-width: 20px;
        min-height: 20px;
        margin: 0;
        padding: 0;
        border: 2px solid var(--muted);
        border-radius: 6px;
        display: grid;
        place-content: center;
        flex-shrink: 0;
      }

      .task-check:checked {
        background: var(--accent);
        border-color: var(--accent);
      }

      .task-check:checked::after {
        content: "";
        width: 5px;
        height: 9px;
        border: solid #0b1220;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -1px);
      }

      .task-title-line {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }

      .task-title-content {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
      }

      .task-title {
        word-break: break-word;
      }

      li.task-row.done .task-title {
        text-decoration: line-through;
        color: var(--muted);
      }

      .task-title-line svg {
        width: 16px;
        height: 16px;
        color: var(--muted);
        flex-shrink: 0;
      }

      .task-note {
        font-size: 0.82rem;
        color: var(--muted);
        margin-left: calc(20px + 0.7rem);
      }

      .date-group {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
        margin: 1.25rem 0 0.4rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--border);
      }

      .task-date-badge {
        color: var(--accent);
        font-weight: 600;
        flex-shrink: 0;
      }

      .date-group.upcoming {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        border-bottom: none;
      }

      .upcoming-day-num {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
      }

      .upcoming-day-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--muted);
        white-space: nowrap;
      }

      .upcoming-day-rule {
        flex: 1;
        align-self: center;
        height: 1px;
        background: var(--border);
      }

      .empty {
        color: var(--muted);
        font-size: 0.9rem;
        padding: 0.5rem 0;
      }

      .error {
        color: var(--danger);
        font-size: 0.85rem;
        min-height: 1.2em;
      }

      /* --- "When?" / "Add Reminder" sheets --------------------------
         Deliberately fixed-dark, not theme-aware: these mimic Things'
         own bottom sheets, which look the same in both app themes. */

      .sheet-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: flex-end;
        z-index: 30;
      }

      .sheet-card {
        width: 100%;
        max-width: 32rem;
        margin: 0 auto;
        background: #1b2333;
        color: #f3f4f6;
        border-radius: 1.1rem 1.1rem 0 0;
        padding: 1rem 1.1rem calc(1.5rem + env(safe-area-inset-bottom));
        max-height: 85vh;
        overflow-y: auto;
      }

      .sheet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .sheet-title {
        font-size: 1.1rem;
        font-weight: 700;
      }

      .sheet-close {
        color: #9aa4b8;
        background: #2c3650;
        border-radius: 50%;
        width: 1.8rem;
        height: 1.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .sheet-close svg {
        width: 14px;
        height: 14px;
      }

      .sheet-row {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 0.2rem;
        text-align: left;
        font-size: 1rem;
        color: #f3f4f6;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .sheet-row-icon {
        width: 1.4rem;
        text-align: center;
        font-size: 1.1rem;
      }

      .sheet-row-icon.star {
        color: #f5c518;
      }

      .sheet-check {
        margin-left: auto;
        width: 16px;
        height: 16px;
        color: #6ea8fe;
      }

      /* #when-reminder-label reuses .sheet-check for its "pushed right"
         positioning, but holds a time string ("11:28") rather than a
         checkmark — it needs room to actually fit that text instead of
         the checkmark's fixed 16px box, which let it overflow past the
         sheet's edge. */
      #when-reminder-label {
        width: auto;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .sheet-check::after {
        content: "";
        display: none;
        width: 5px;
        height: 9px;
        border: solid #6ea8fe;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) translate(-1px, -3px);
      }

      .sheet-check.checked::after {
        display: block;
      }

      .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        font-size: 0.7rem;
        color: #9aa4b8;
        text-align: center;
        margin-top: 0.75rem;
      }

      .cal-month-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #9aa4b8;
        margin-top: 0.5rem;
      }

      .cal-month-label button {
        color: #6ea8fe;
        padding: 0.2rem 0.5rem;
      }

      .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.2rem;
        margin-top: 0.4rem;
      }

      .cal-day {
        aspect-ratio: 1;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        color: #f3f4f6;
        position: relative;
      }

      .cal-day.selected {
        background: #6ea8fe;
        color: #0b1220;
        font-weight: 600;
      }

      .cal-today-mark {
        position: absolute;
        bottom: 2px;
        font-size: 0.5rem;
        color: #f5c518;
      }

      .sheet-clear {
        width: 100%;
        text-align: center;
        background: #3a2230;
        color: #f87171;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.7rem;
        margin-top: 1rem;
      }

      .reminder-time-input {
        background: #2c3650;
        border: none;
        border-radius: 0.6rem;
        color: #f3f4f6;
        font-size: 1.3rem;
        padding: 0.75rem;
        text-align: center;
        margin: 0.5rem 0 1rem;
      }

      .sheet-actions {
        display: flex;
        gap: 0.6rem;
      }

      .sheet-actions button {
        flex: 1;
        padding: 0.6rem;
        border-radius: 0.6rem;
        text-align: center;
        background: #2c3650;
        color: #f3f4f6;
      }

      .sheet-actions button.primary {
        background: #6ea8fe;
        color: #0b1220;
        font-weight: 600;
      }

      [hidden] {
        display: none !important;
      }
    </style>
  </head>
  <body data-vapid-key={vapidPublicKey}>
    <div id="gate">
      <h1>Punkt</h1>
      <form id="gate-form">
        <input
          id="gate-input"
          type="password"
          placeholder="Åtkomstkod"
          autocomplete="current-password"
          required
        />
        <button
          type="submit"
          style="background:var(--accent);color:#0b1220;font-weight:600;border-radius:0.5rem;padding:0.5rem 0.9rem;"
          >Lås upp</button
        >
        <p id="gate-error" class="error"></p>
      </form>
    </div>

    <div id="app" hidden>
      <div id="save-error" class="save-error" hidden>
        <span id="save-error-text"></span>
        <button type="button" id="save-error-retry">Försök igen</button>
      </div>

      <div id="view-menu" class="screen">
        <div class="menu-header">
          <h1>Punkt</h1>
          <button id="menu-add-btn" class="fab" aria-label="Ny uppgift">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
        </div>
        <nav id="menu-list"></nav>
      </div>

      <div id="view-list" class="screen" hidden>
        <div class="list-header">
          <div class="list-header-left">
            <button id="back-btn" aria-label="Tillbaka">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" transform="translate(-9, 0)"></polyline></svg>
            </button>
            <h1 id="list-title"></h1>
          </div>
          <div class="list-header-right">
            <button id="add-btn" class="fab" aria-label="Ny uppgift">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
            </button>
            <button id="done-btn" class="done-pill" hidden>Done</button>
          </div>
        </div>

        <div id="quick-add-scrim" hidden></div>
        <div id="quick-add-anchor"></div>
